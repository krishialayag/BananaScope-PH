# Import Advanced Analytics Engine (PRESERVED 100%)
from analytics_engine import (
    compute_yoy_growth,
    calculate_cagr,
    compute_trend_models,
    detect_statistical_anomalies,
    run_time_series_forecast
)

# -----------------------------------------------------------------------------
# 1. PAGE CONFIGURATION & PASTEL NEUMORPHIC THEME
# -----------------------------------------------------------------------------
st.set_page_config(
    page_title="BananaScope PH | Philippine Banana Analytics",
    page_icon="🍌",
    layout="wide",
    initial_sidebar_state="expanded"
)

# Ordered List of All 13 Analytical Views (Sequenced for Smooth Next/Back Navigation)
