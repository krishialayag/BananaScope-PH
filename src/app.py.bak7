                "Upper_CI_MT": st.column_config.NumberColumn("Upper 95% Confidence Bound (MT)", format="%,.2f MT"),
                "Type": st.column_config.TextColumn("Projection Type")
            }
        )
        render_explanation(
            "Projected Scenario Table",
            "This table details the projected production estimates for upcoming calendar years alongside their calculated 95% confidence bounds. "
            "The lower and upper bounds show the statistical range within which production is expected to fall based on historical trend patterns. "
            "Agricultural planners and cooperatives can use these baseline estimates for resource allocation and supply planning."
        )
