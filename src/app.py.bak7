    /* ---------------- STREAMLIT BUTTON OVERRIDES (PASTEL NEUMORPHIC) ---------------- */
    /* Primary Action Buttons (Soft Coral Gradient) */
    button[kind="primary"] {
        background: linear-gradient(145deg, #F08E76 0%, #E07A5F 100%) !important;
        color: #FFFFFF !important;
