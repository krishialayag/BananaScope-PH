    /* ========================================================================= */
    /* 3. HERO BANNER & INSIGHTS CARDS                                          */
    /* ========================================================================= */
    .hero-banner {
        background: linear-gradient(135deg, rgba(255, 243, 199, 0.88) 0%, rgba(255, 255, 255, 0.95) 100%);
        backdrop-filter: blur(8px);
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        border: 1.5px solid var(--sunlit-cream-border);
        border-left: 6px solid var(--lavender-haze);
