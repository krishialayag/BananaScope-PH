    .badge-cream { background: var(--sunlit-cream); border-color: var(--sunlit-cream-border); }
    .badge-sage { background: var(--sage-mist); border-color: var(--sage-mist-border); }
    .badge-aqua { background: var(--aqua-breeze); border-color: var(--aqua-breeze-border); }
    .badge-cloud { background: var(--cloud-blue); border-color: var(--cloud-blue-border); }
    .badge-lavender { background: var(--lavender-haze); border-color: var(--lavender-haze-border); }

    /* Surveillance / Insights Card */
    .insights-card {
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(8px);
        border-radius: 14px;
        box-shadow: var(--card-shadow);
