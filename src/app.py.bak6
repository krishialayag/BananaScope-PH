            font-size: 0.95rem !important;
        }
        .growth-kpi-val {
            font-size: 1.65rem !important;
        }
        .neu-card {
            padding: 16px 18px !important;
            border-radius: 16px !important;
        }
        /* Mobile Stack Columns */
        [data-testid="column"] {
            min-width: 100% !important;
            flex: 1 1 100% !important;
            margin-bottom: 8px !important;
        }
    }

    /* Footer styling */
    .dashboard-footer {
        text-align: center;
        background: #FFFDF4;
        border-radius: 20px;
        box-shadow: 6px 6px 16px var(--shadow-dark), -6px -6px 16px var(--shadow-light);
        border: 1px solid rgba(255, 255, 255, 0.9);
        color: var(--forest-green);
        padding: 18px 20px;
        margin-top: 36px;
    }
    .dashboard-footer strong {
        color: var(--golden-orange);
    }
</style>
""", unsafe_allow_html=True)


# -----------------------------------------------------------------------------
# 2. DATA INGESTION & CACHING (PRESERVED 100%)
# -----------------------------------------------------------------------------
@st.cache_data
def load_dataset():
    """Loads and standardizes the cleaned dataset."""
    possible_paths = [
        "outputs/cleaned_banana_data.csv",
        "cleaned_banana_data.csv",
        "data/cleaned_banana_data.csv"
    ]
    for path in possible_paths:
        if os.path.exists(path):
            df = pd.read_csv(path)
            df['Year'] = df['Year'].astype(int)
            df['Volume_MT'] = pd.to_numeric(df['Volume_MT'], errors='coerce')
            return df
            
    st.error("Cleaned dataset not found! Please run `src/data_cleaning.py` first.")
    st.stop()

df = load_dataset()


# -----------------------------------------------------------------------------
# 3. SIDEBAR CONTROLS & INTERACTIVE FILTERS (PRESERVED 100% FUNCTIONALITY)
# -----------------------------------------------------------------------------
with st.sidebar:
    st.markdown("""
    <div class="sidebar-neu-brand">
        <div class="sidebar-brand-title">
            <span>🍌</span> Banana Scope PH
        </div>
        <div class="sidebar-brand-subtitle">
            Philippine Banana Production Analytics Platform (2010–2026)
        </div>
        <span class="sidebar-tag">🇵🇭 DepEd MIMAROPA • Grade 12</span>
    </div>
    """, unsafe_allow_html=True)

    st.markdown("### 🎛️ **Surveillance Filters**")
    st.caption("Interactive multi-attribute agricultural surveillance filters.")

    # 1. Year Range Filter (PRESERVED)
    min_year = int(df['Year'].min())
    max_year = int(df['Year'].max())
    selected_years = st.slider(
        "📅 **Select Year Horizon:**",
        min_value=min_year,
        max_value=max_year,
        value=(2010, min(2024, max_year)),
        step=1
    )

    # 2. Measurement Frequency (PRESERVED)
    period_options = ["Annual (Recommended)", "Quarterly (Q1–Q4)", "Semester (S1–S2)"]
    selected_period_type = st.radio(
        "⏱️ **Reporting Frequency:**",
        options=period_options,
        index=0,
        help="Annual totals prevent double-counting. Choose Quarterly to inspect intra-annual cycles."
    )

    quarter_filter = "All"
    if selected_period_type == "Quarterly (Q1–Q4)":
        quarter_filter = st.selectbox("Select Specific Quarter:", ["All", "Q1", "Q2", "Q3", "Q4"])

    st.markdown("---")

    # 3. Banana Variety Scope (PRESERVED)
    all_varieties = sorted(df['Crop'].unique().tolist())
    variety_mode = st.radio(
        "🍌 **Cultivar Scope:**",
        ["Total Banana (Aggregated)", "Specific Cultivars Breakdown", "Custom Selection"],
        index=0
    )

    if variety_mode == "Total Banana (Aggregated)":
        selected_varieties = ["Banana (Total)"]
    elif variety_mode == "Specific Cultivars Breakdown":
        selected_varieties = [v for v in all_varieties if v != "Banana (Total)"]
    else:
        selected_varieties = st.multiselect(
            "Select Banana Varieties:",
            options=all_varieties,
            default=["Banana (Total)"]
        )
        if not selected_varieties:
            selected_varieties = ["Banana (Total)"]

    st.markdown("---")

    # 4. Regional Filter (PRESERVED)
    available_regions = sorted(df[df['Hierarchy_Level'] == 'Regional']['Region'].unique().tolist())
    all_regions_opt = "All Administrative Regions (National Scope)"
    region_options = [all_regions_opt] + available_regions

    selected_region = st.selectbox(
        "🗺️ **Select Region:**",
        options=region_options,
        index=0
    )

    # 5. Cascading Provincial Filter (PRESERVED)
    if selected_region == all_regions_opt:
        available_provinces = sorted(df[df['Hierarchy_Level'].isin(['Provincial', 'City'])]['Province_City'].unique().tolist())
    else:
        available_provinces = sorted(df[(df['Region'] == selected_region) & 
                                        (df['Hierarchy_Level'].isin(['Provincial', 'City']))]['Province_City'].unique().tolist())

    all_prov_opt = "All Provinces / Cities"
    province_options = [all_prov_opt] + available_provinces

    selected_province = st.selectbox(
        "📍 **Select Province / City:**",
        options=province_options,
        index=0
    )

    st.markdown("---")
    st.markdown("""
    <div style="background: #FFFDF4; border-radius: 14px; padding: 12px 14px; box-shadow: inset 2px 2px 5px rgba(215, 134, 1, 0.1); font-size: 0.78rem; line-height: 1.45;">
        <strong style="color: #055922;">🏫 Leuteboro National High School</strong><br>
        Fundamentals of Data Analytics (2026–2027)<br>
        Supervised by <strong style="color: #D78601;">Sir Aldrin D. Magtibay</strong><br>
        <em>DepEd Division of Oriental Mindoro</em>
    </div>
    """, unsafe_allow_html=True)


# -----------------------------------------------------------------------------
# 4. FILTERING LOGIC (PRESERVED 100%)
# -----------------------------------------------------------------------------
filtered_df = df[(df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1])].copy()

# Period Type Filter
if selected_period_type == "Annual (Recommended)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Annual'].copy()
elif selected_period_type == "Quarterly (Q1–Q4)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Quarterly'].copy()
    if quarter_filter != "All":
        filtered_df = filtered_df[filtered_df['Period'] == quarter_filter].copy()
elif selected_period_type == "Semester (S1–S2)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Semester'].copy()

# Cultivar Filter
filtered_df = filtered_df[filtered_df['Crop'].isin(selected_varieties)].copy()

# Geographic Hierarchy Routing
if selected_province != all_prov_opt:
    active_df = filtered_df[filtered_df['Province_City'] == selected_province].copy()
    geo_label = selected_province
    geo_level = "Provincial"
elif selected_region != all_regions_opt:
    active_df = filtered_df[(filtered_df['Region'] == selected_region) & 
                            (filtered_df['Hierarchy_Level'] == 'Regional')].copy()
    geo_label = selected_region
    geo_level = "Regional"
else:
    active_df = filtered_df[filtered_df['Hierarchy_Level'] == 'National'].copy()
    geo_label = "Philippines (National Aggregate)"
    geo_level = "National"


# -----------------------------------------------------------------------------
# 5. SUMMARY CALCULATIONS FOR KPI SUMMARY (PRESERVED CALCULATIONS)
# -----------------------------------------------------------------------------
valid_vols = active_df['Volume_MT'].dropna()
total_production_mt = valid_vols.sum()

if not active_df.empty and active_df['Year'].nunique() > 0:
    yearly_totals = active_df.groupby('Year')['Volume_MT'].sum()
    avg_annual_mt = yearly_totals.mean()
    if not yearly_totals.empty:
        peak_year = int(yearly_totals.idxmax())
        peak_vol_mt = yearly_totals.max()
        lowest_year = int(yearly_totals.idxmin())
        lowest_vol_mt = yearly_totals.min()
    else:
        peak_year, peak_vol_mt, lowest_year, lowest_vol_mt = "N/A", 0, "N/A", 0
else:
    avg_annual_mt = 0
    peak_year, peak_vol_mt, lowest_year, lowest_vol_mt = "N/A", 0, "N/A", 0

# Benchmark Top Producing Region across selected period (PRESERVED)
reg_benchmark = df[
    (df['Year'] >= selected_years[0]) & 
    (df['Year'] <= selected_years[1]) & 
    (df['Hierarchy_Level'] == 'Regional') &
    (df['Crop'].isin(selected_varieties)) &
    (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly'))
]
if not reg_benchmark.empty:
    top_reg_series = reg_benchmark.groupby('Region')['Volume_MT'].sum()
    top_region_name = top_reg_series.idxmax().replace("REGION ", "Reg ").replace("ADMINISTRATIVE REGION", "CAR")
    top_region_vol = top_reg_series.max()
else:
    top_region_name, top_region_vol = "N/A", 0


# -----------------------------------------------------------------------------
# 6. PLOTLY NEUMORPHIC THEME & HELPERS
# -----------------------------------------------------------------------------
PLOT_THEME = dict(
    plot_bgcolor="#FFFDF8",
    paper_bgcolor="#FFFDF8",
    font=dict(family="'Plus Jakarta Sans', sans-serif", color="#055922"),
    hoverlabel=dict(bgcolor="#055922", font_color="#FCF0BC", font_family="'Plus Jakarta Sans', sans-serif")
)

def render_explanation(chart_title, explanation_text):
    """Renders a beginner-friendly 2-4 sentence explanation card directly below each visual."""
    st.markdown(f"""
    <div class="chart-explanation">
        <div class="chart-explanation-title">🌿 Understanding This Visual: {chart_title}</div>
        <div class="chart-explanation-body">{explanation_text}</div>
    </div>
    """, unsafe_allow_html=True)

def render_view_header(view_id):
    """Renders persistent Home and Next navigation buttons with active section indicator."""
    current_idx = next((i for i, s in enumerate(NAV_SECTIONS) if s["id"] == view_id), 0)
    current_sec = NAV_SECTIONS[current_idx]
    has_next = current_idx < len(NAV_SECTIONS) - 1
    next_sec = NAV_SECTIONS[current_idx + 1] if has_next else None
    has_prev = current_idx > 0
    prev_sec = NAV_SECTIONS[current_idx - 1] if has_prev else None

    # Elevated Neumorphic Section Status Bar
    st.markdown(f"""
    <div class="neu-card" style="padding: 14px 20px; margin-bottom: 18px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.3rem;">{current_sec['icon']}</span>
                <div>
                    <div style="font-size: 0.78rem; font-weight: 800; color: #849B0F; text-transform: uppercase; letter-spacing: 0.6px;">
                        Category: {current_sec['category']}
                    </div>
                    <div style="font-size: 1.15rem; font-weight: 800; color: #055922;">
                        {current_sec['title']}
                    </div>
                </div>
            </div>
            <div style="background: #FDF5CF; border-radius: 12px; padding: 4px 14px; font-weight: 800; font-size: 0.84rem; color: #055922; border: 1px solid rgba(215, 134, 1, 0.2); box-shadow: inset 1px 1px 3px rgba(215, 134, 1, 0.1);">
                Section {current_idx + 1} of {len(NAV_SECTIONS)}
            </div>
        </div>
    </div>
    """, unsafe_allow_html=True)

    # Neumorphic Navigation Buttons Row
    c_home, c_prev, c_next = st.columns([1.5, 1.5, 2.2])
    with c_home:
        if st.button("🏠 Home", key=f"top_home_{view_id}", type="primary", use_container_width=True):
            st.session_state.active_view = "HOME"
            st.rerun()

    with c_prev:
        if has_prev:
            if st.button("⬅️ Previous", key=f"top_prev_{view_id}", type="secondary", use_container_width=True):
                st.session_state.active_view = prev_sec["id"]
                st.rerun()
        else:
            st.button("⬅️ Previous", key=f"top_prev_dis_{view_id}", disabled=True, use_container_width=True)

    with c_next:
        if has_next:
            if st.button(f"Next: {next_sec['short_title']} ➡️", key=f"top_next_{view_id}", type="primary", use_container_width=True):
                st.session_state.active_view = next_sec["id"]
                st.rerun()
        else:
            if st.button("🏠 Return to Home", key=f"top_next_home_{view_id}", type="primary", use_container_width=True):
                st.session_state.active_view = "HOME"
                st.rerun()

def render_view_footer(view_id):
    """Renders bottom Home and Next navigation controls."""
    current_idx = next((i for i, s in enumerate(NAV_SECTIONS) if s["id"] == view_id), 0)
    has_next = current_idx < len(NAV_SECTIONS) - 1
    next_sec = NAV_SECTIONS[current_idx + 1] if has_next else None
    has_prev = current_idx > 0
    prev_sec = NAV_SECTIONS[current_idx - 1] if has_prev else None

    st.markdown("<div style='margin-top: 20px;'></div>", unsafe_allow_html=True)
    c_home, c_prev, c_next = st.columns([1.5, 1.5, 2.2])
    with c_home:
        if st.button("🏠 Home", key=f"bot_home_{view_id}", type="secondary", use_container_width=True):
            st.session_state.active_view = "HOME"
            st.rerun()

    with c_prev:
        if has_prev:
            if st.button("⬅️ Previous Section", key=f"bot_prev_{view_id}", type="secondary", use_container_width=True):
                st.session_state.active_view = prev_sec["id"]
                st.rerun()

    with c_next:
        if has_next:
            if st.button(f"Next: {next_sec['short_title']} ➡️", key=f"bot_next_{view_id}", type="primary", use_container_width=True):
                st.session_state.active_view = next_sec["id"]
                st.rerun()
        else:
            if st.button("🏠 Return to Home", key=f"bot_next_home_{view_id}", type="primary", use_container_width=True):
                st.session_state.active_view = "HOME"
                st.rerun()


# =============================================================================
# 7. REUSABLE CHART & TABLE VIEW FUNCTIONS (SINGLE-VIEW DISPLAY)
# =============================================================================

def render_annual_trajectory_view():
    render_view_header("ANNUAL_TRAJECTORY")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>📈 Annual Banana Production (Metric Tons, 2010–2024)</div>", unsafe_allow_html=True)
    if not active_df.empty:
        annual_plot_data = active_df.groupby(['Year', 'Crop'])['Volume_MT'].sum().reset_index()
        fig_traj = px.line(
            annual_plot_data, x='Year', y='Volume_MT', color='Crop',
            markers=True, line_shape='spline',
            color_discrete_sequence=['#055922', '#849B0F', '#D78601', '#95AC29', '#FBE05A', '#B07204'],
            labels={'Volume_MT': 'Production Volume (Metric Tons)', 'Year': 'Calendar Year'}
        )
        fig_traj.update_layout(
            **PLOT_THEME,
            height=500,
            hovermode="x unified",
            margin=dict(l=60, r=30, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,244,0.9)")
        )
        fig_traj.update_traces(marker=dict(size=8, line=dict(color='#FFFDF4', width=1.5)))
        fig_traj.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=10)
        fig_traj.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_traj, use_container_width=True)
        render_explanation(
            "Annual Banana Production Trajectory",
            "This chart shows the total volume of bananas harvested each year across the selected time period and region. "
            "It helps viewers easily track whether production has been growing, declining, or remaining steady over the 15-year period. "
            "At the national level, production grew steadily toward its 2018 peak of 9.36 million metric tons before entering a multi-year decline."
        )
    else:
        st.warning("No data available for the current filter selection.")
    render_view_footer("ANNUAL_TRAJECTORY")

def render_quarterly_seasonality_view():
    render_view_header("QUARTERLY_SEASONALITY")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>⏱️ Seasonal Quarterly Harvest Patterns (Q1–Q4 Average Volume)</div>", unsafe_allow_html=True)
    q_subset = df[(df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & (df['Period_Type'] == 'Quarterly') & (df['Crop'].isin(selected_varieties))]
    if selected_province != all_prov_opt:
        q_subset = q_subset[q_subset['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        q_subset = q_subset[(q_subset['Region'] == selected_region) & (q_subset['Hierarchy_Level'] == 'Regional')]
    else:
        q_subset = q_subset[q_subset['Hierarchy_Level'] == 'National']

    if not q_subset.empty:
        q_agg = q_subset.groupby('Period')['Volume_MT'].mean().reindex(['Q1', 'Q2', 'Q3', 'Q4']).reset_index()
        labels_txt = [f"{v/1e6:.2f}M MT" if v >= 1e6 else f"{v/1e3:,.0f}K MT" for v in q_agg['Volume_MT']]
        fig_q = px.bar(
            q_agg, x='Period', y='Volume_MT', color='Period',
            color_discrete_sequence=['#D78601', '#849B0F', '#FBE05A', '#055922'],
            labels={'Volume_MT': 'Average Harvest (Metric Tons)', 'Period': 'Quarter'},
            text=labels_txt
        )
        max_val = q_agg['Volume_MT'].max()
        fig_q.update_traces(
            marker_line_color='#055922', marker_line_width=1,
            textposition='outside', cliponaxis=False,
            textfont=dict(size=12, family="'Plus Jakarta Sans', sans-serif", color='#055922')
        )
        fig_q.update_layout(
            **PLOT_THEME,
            height=480,
            showlegend=False,
            margin=dict(l=60, r=30, t=50, b=50)
        )
        fig_q.update_yaxes(gridcolor='#EADBCA', range=[0, max_val * 1.20], tickformat=",.0f")
        fig_q.update_xaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_q, use_container_width=True)
        render_explanation(
            "Seasonal Quarterly Harvest Patterns",
            "This chart compares the average volume of bananas harvested in each of the four calendar quarters of the year. "
            "It shows that Quarter 1 (January to March) regularly has the lowest harvest volume, while Quarters 2, 3, and 4 maintain higher and more consistent production levels. "
            "Farmers, buyers, and agricultural planners can use this seasonal pattern to prepare for supply changes and market price fluctuations."
        )
    else:
        st.warning("No quarterly records found for the current selection.")
    render_view_footer("QUARTERLY_SEASONALITY")

def render_regional_rankings_view():
    render_view_header("REGIONAL_RANKINGS")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🗺️ Regional Banana Production Comparison Across the Philippines</div>", unsafe_allow_html=True)
    reg_data = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Hierarchy_Level'] == 'Regional') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly')) &
        (df['Crop'].isin(selected_varieties))
    ].groupby('Region')['Volume_MT'].sum().reset_index().sort_values('Volume_MT', ascending=True)

    if not reg_data.empty:
        reg_data['Clean_Region'] = reg_data['Region'].str.replace(r'REGION [IVX]+ \((.*?)\)', r'\1', regex=True)
        bar_labels = [f"{v/1e6:.2f}M MT" if v >= 1e6 else f"{v/1e3:,.0f}K MT" for v in reg_data['Volume_MT']]
        fig_reg = px.bar(
            reg_data, x='Volume_MT', y='Clean_Region', orientation='h',
            color='Volume_MT', color_continuous_scale=['#FCF0BC', '#FBE05A', '#849B0F', '#055922'],
            labels={'Volume_MT': 'Total Production (Metric Tons)', 'Clean_Region': 'Administrative Region'},
            text=bar_labels
        )
        max_reg = reg_data['Volume_MT'].max()
        fig_reg.update_traces(
            marker_line_color='#055922', marker_line_width=0.8,
            textposition='outside', cliponaxis=False,
            textfont=dict(size=10.5, family="'Plus Jakarta Sans', sans-serif")
        )
        fig_reg.update_layout(
            **PLOT_THEME,
            height=max(560, len(reg_data) * 34),
            coloraxis_showscale=False,
            margin=dict(l=150, r=70, t=40, b=40)
        )
        fig_reg.update_xaxes(gridcolor='#EADBCA', range=[0, max_reg * 1.22], tickformat=",.0f")
        fig_reg.update_yaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_reg, use_container_width=True)
        render_explanation(
            "Regional Banana Production Comparison",
            "This chart ranks Philippine administrative regions from highest to lowest based on total recorded banana production. "
            "It reveals that banana farming is heavily concentrated in Mindanao, where Davao Region alone produces over half of the national harvest. "
            "Island regions like MIMAROPA produce smaller volumes that are primarily consumed locally."
        )
    else:
        st.warning("No regional records found for current filters.")
    render_view_footer("REGIONAL_RANKINGS")

def render_cultivar_donut_view():
    render_view_header("CULTIVAR_DONUT")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🍌 Market Share Breakdown by Banana Variety</div>", unsafe_allow_html=True)
    cult_df = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Crop'] != 'Banana (Total)') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly'))
    ]
    if selected_province != all_prov_opt:
        cult_df = cult_df[cult_df['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        cult_df = cult_df[(cult_df['Region'] == selected_region) & (cult_df['Hierarchy_Level'] == 'Regional')]
    else:
        cult_df = cult_df[cult_df['Hierarchy_Level'] == 'National']

    if not cult_df.empty:
        cult_agg = cult_df.groupby('Crop')['Volume_MT'].sum().reset_index()
        cult_agg['Crop_Name'] = cult_agg['Crop'].str.replace('Banana ', '')
        fig_donut = px.pie(
            cult_agg, names='Crop_Name', values='Volume_MT', hole=0.48,
            color_discrete_sequence=['#FBE05A', '#849B0F', '#055922', '#D78601', '#95AC29', '#B07204']
        )
        fig_donut.update_traces(
            marker=dict(line=dict(color='#FFFDF4', width=2)),
            textposition='inside', textinfo='percent+label',
            textfont=dict(size=12, color='#FFFFFF')
        )
        fig_donut.update_layout(
            **PLOT_THEME,
            height=480,
            margin=dict(l=30, r=30, t=40, b=40),
            legend=dict(orientation="h", yanchor="bottom", y=-0.18, xanchor="center", x=0.5)
        )
        st.plotly_chart(fig_donut, use_container_width=True)
        render_explanation(
            "Market Share Breakdown by Variety",
            "This chart illustrates the market share of each major banana variety in total Philippine production. "
            "Cavendish (grown mainly for export to countries like Japan and China) and Saba (used for local cooking and banana chips) "
            "together account for about 80% of all harvested bananas. "
            "Dessert varieties like Lakatan and Latundan make up the majority of the remaining domestic harvest."
        )
    else:
        st.warning("No cultivar records found for current selection.")
    render_view_footer("CULTIVAR_DONUT")

def render_variety_comparison_view():
    render_view_header("VARIETY_COMPARISON")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🍌 Multi-Year Harvest Trends by Banana Variety</div>", unsafe_allow_html=True)
    multi_var_df = df[(df['Hierarchy_Level'] == 'National') & (df['Crop'] != 'Banana (Total)') & (df['Period_Type'] == 'Annual') & (df['Year'] <= selected_years[1]) & (df['Year'] >= selected_years[0])]
    if not multi_var_df.empty:
        fig_cult_growth = px.line(
            multi_var_df, x='Year', y='Volume_MT', color='Crop',
            markers=True, line_shape='spline',
            color_discrete_sequence=['#055922', '#849B0F', '#FBE05A', '#D78601', '#95AC29'],
            labels={'Volume_MT': 'Volume (Metric Tons)', 'Year': 'Calendar Year'}
        )
        fig_cult_growth.update_layout(
            **PLOT_THEME,
            height=500,
            hovermode="x unified",
            margin=dict(l=60, r=30, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,244,0.9)")
        )
        fig_cult_growth.update_traces(marker=dict(size=7, line=dict(color='#FFFDF4', width=1.5)))
        fig_cult_growth.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=10)
        fig_cult_growth.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_cult_growth, use_container_width=True)
        render_explanation(
            "Multi-Year Harvest Trends by Variety",
            "This chart tracks and compares the yearly production volumes of individual banana varieties over time. "
            "It reveals that export Cavendish experienced sharp declines after 2018 due to the spread of Fusarium Wilt (Panama disease), "
            "whereas domestic varieties like Saba showed greater stability and resilience. "
            "Comparing varieties helps agricultural planners identify which crops need targeted disease management."
        )
    else:
        st.warning("No multi-variety records available for current selection.")
    render_view_footer("VARIETY_COMPARISON")

def render_yoy_growth_view():
    render_view_header("YOY_GROWTH")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>📊 Annual Year-over-Year Percentage Growth (% Change)</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 2:
        yoy_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        yoy_df = compute_yoy_growth(yoy_base)
        yoy_clean = yoy_df.dropna(subset=['YoY_Growth_Pct']).copy()

        # Growth Metrics Calculations (PRESERVED)
        start_y = yearly_totals.index.min()
        end_y = yearly_totals.index.max()
        v_start = yearly_totals.loc[start_y]
        v_end = yearly_totals.loc[end_y]
        cagr_val = calculate_cagr(v_start, v_end, end_y - start_y)
        mean_yoy = yoy_clean['YoY_Growth_Pct'].mean()
        max_growth_row = yoy_clean.loc[yoy_clean['YoY_Growth_Pct'].idxmax()]
        min_growth_row = yoy_clean.loc[yoy_clean['YoY_Growth_Pct'].idxmin()]

        # 4 CLEAN NEUMORPHIC KPI METRIC CARDS (NO DOTS, CLEAN READABLE NUMBERS)
        g_c1, g_c2, g_c3, g_c4 = st.columns(4)
        with g_c1:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--leaf-green);">
                <div class="growth-kpi-label">Compound Annual Growth (CAGR)</div>
                <div class="growth-kpi-val">{cagr_val:+.2f}% <span class="unit-text">/ year</span></div>
                <div class="growth-kpi-sub">Smoothed trajectory ({start_y}–{end_y})</div>
            </div>
            """, unsafe_allow_html=True)
        with g_c2:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--forest-green);">
                <div class="growth-kpi-label">Average Annual YoY Growth</div>
                <div class="growth-kpi-val">{mean_yoy:+.2f}%</div>
                <div class="growth-kpi-sub">Mean yearly percentage change</div>
            </div>
            """, unsafe_allow_html=True)
        with g_c3:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--banana-yellow);">
                <div class="growth-kpi-label">Highest Growth Surge</div>
                <div class="growth-kpi-val">{max_growth_row['YoY_Growth_Pct']:+.1f}%</div>
                <div class="growth-kpi-sub">Recorded in calendar year {int(max_growth_row['Year'])}</div>
            </div>
            """, unsafe_allow_html=True)
        with g_c4:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--golden-orange);">
                <div class="growth-kpi-label">Deepest Harvest Contraction</div>
                <div class="growth-kpi-val">{min_growth_row['YoY_Growth_Pct']:+.1f}%</div>
                <div class="growth-kpi-sub">Recorded in calendar year {int(min_growth_row['Year'])}</div>
            </div>
            """, unsafe_allow_html=True)

        # Simplified YoY Labels (1 decimal place)
        yoy_clean['Growth_Color'] = np.where(yoy_clean['YoY_Growth_Pct'] >= 0, 'Expansion (+)', 'Contraction (-)')
        yoy_clean['Display_Text'] = yoy_clean['YoY_Growth_Pct'].apply(lambda x: f"{x:+.1f}%")

        min_pct = yoy_clean['YoY_Growth_Pct'].min()
        max_pct = yoy_clean['YoY_Growth_Pct'].max()
        y_lower = min(0, min_pct) * 1.35 if min_pct < 0 else -2
        y_upper = max(0, max_pct) * 1.35 if max_pct > 0 else 5

        fig_yoy = px.bar(
            yoy_clean, x='Year', y='YoY_Growth_Pct', color='Growth_Color',
            color_discrete_map={'Expansion (+)': '#849B0F', 'Contraction (-)': '#D78601'},
            labels={'YoY_Growth_Pct': 'Annual Growth Rate (%)', 'Year': 'Calendar Year'},
            text='Display_Text'
        )
        fig_yoy.add_hline(y=0, line_dash="solid", line_color="#D78601", line_width=1.5)
        fig_yoy.update_traces(
            textposition='outside', cliponaxis=False,
            textfont=dict(size=11, family="'Plus Jakarta Sans', sans-serif", color='#055922'),
            marker_line_color='#055922', marker_line_width=1
        )
        fig_yoy.update_layout(
            **PLOT_THEME,
            height=480,
            bargap=0.28,
            margin=dict(l=60, r=30, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_yoy.update_yaxes(gridcolor='#EADBCA', ticksuffix='%', range=[y_lower, y_upper], title_standoff=10)
        fig_yoy.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_yoy, use_container_width=True)
        render_explanation(
            "Annual Year-over-Year Percentage Growth",
            "This chart displays the percentage increase or decrease in banana production for each year compared to the year before. "
            "Olive green bars pointing upward represent years when production expanded, while golden orange bars pointing downward indicate years when harvests contracted. "
            "Viewers can quickly pinpoint boom periods like 2018 (+2.4%) as well as severe drops like 2013 (-8.1%) without having to calculate percentages manually."
        )
    else:
        st.warning("Insufficient data points to compute Year-over-Year growth rates. Expand the year horizon slider.")
    render_view_footer("YOY_GROWTH")

def render_moving_average_view():
    render_view_header("MOVING_AVERAGE")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🌾 Production Volume with 3-Year Rolling Average & Long-Term Trendline</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 2:
        yoy_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        trend_df, t_stats = compute_trend_models(yoy_base)

        fig_smooth = go.Figure()
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Volume_MT'], mode='lines+markers',
            name='Actual Annual Output', line=dict(color='#055922', width=3),
            marker=dict(size=8, color='#055922', line=dict(color='#FFFDF4', width=1.5))
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['SMA_3'], mode='lines',
            name='3-Year Moving Average (SMA-3)', line=dict(color='#849B0F', width=2.5, dash='dot')
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Linear_Trend'], mode='lines',
            name=f"OLS Linear Trend (R² = {t_stats['r_squared']:.2f})", line=dict(color='#D78601', width=2.5, dash='dash')
        ))
        fig_smooth.update_layout(
            **PLOT_THEME,
            height=500,
            hovermode="x unified",
            margin=dict(l=60, r=30, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,244,0.9)")
        )
        fig_smooth.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=10)
        fig_smooth.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_smooth, use_container_width=True)
        render_explanation(
            "3-Year Moving Average & Long-Term Trendline",
            "This chart combines actual yearly production totals with a 3-year smoothed average and a straight long-term trendline. "
            "The 3-year moving average smooths out temporary annual fluctuations to highlight the true multi-year direction of banana production. "
            "The straight dashed line shows the overall historical rate of change across the entire 15-year observation period."
        )
    else:
        st.warning("Insufficient data points to compute rolling moving averages.")
    render_view_footer("MOVING_AVERAGE")

def render_anomalies_scatter_view():
    render_view_header("ANOMALIES_SCATTER")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🔍 Statistical Detection of Extreme Harvests & Production Shocks (Z-Scores)</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 4:
        anom_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        anom_df = detect_statistical_anomalies(anom_base, z_thresh=1.4)

        anomaly_text = [str(y) if flag != 'Normal Production' else '' for y, flag in zip(anom_df['Year'], anom_df['Anomaly_Flag'])]

        fig_anom = px.scatter(
            anom_df, x='Year', y='Volume_MT', color='Anomaly_Flag',
            size=np.abs(anom_df['Z_Score']) + 3.0,
            color_discrete_map={
                'Normal Production': '#849B0F',
                'Unusually High Output': '#FBE05A',
                'Unusually Low Shock': '#D78601',
                'Unrecorded': '#9ca3af'
            },
            labels={'Volume_MT': 'Harvest Volume (Metric Tons)', 'Year': 'Calendar Year'},
            text=anomaly_text
        )
        fig_anom.update_traces(
            textposition='top center',
            textfont=dict(size=12, family="'Plus Jakarta Sans', sans-serif", color='#055922'),
            marker=dict(line=dict(color='#055922', width=1.5))
        )
        
        v_mean = anom_base['Volume_MT'].mean()
        v_std = anom_base['Volume_MT'].std()
        fig_anom.add_hline(y=v_mean, line_color="#055922", line_width=2, annotation_text=f"Historical Mean: {v_mean/1e3:.1f}K MT", annotation_position="top left")
        fig_anom.add_hline(y=v_mean + 1.4 * v_std, line_dash="dot", line_color="#D78601", line_width=2, annotation_text="+1.4σ Upper Bound (Boom)", annotation_position="top left")
        fig_anom.add_hline(y=max(0, v_mean - 1.4 * v_std), line_dash="dot", line_color="#D78601", line_width=2, annotation_text="-1.4σ Lower Bound (Shock)", annotation_position="bottom left")

        fig_anom.update_layout(
            **PLOT_THEME,
            height=500,
            margin=dict(l=60, r=30, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_anom.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=10)
        fig_anom.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_anom, use_container_width=True)
        render_explanation(
            "Statistical Anomaly & Shock Detection",
            "This chart uses standardized statistical scores (Z-scores) to objectively identify unusual harvest years that deviated significantly from normal historical levels. "
            "Data points falling below the lower dotted line represent severe agricultural shock years—such as major typhoon damage or severe droughts—while points above the upper dotted line indicate exceptional harvest booms. "
            "For example, in Oriental Mindoro, this chart flags the severe production drops caused by Typhoon Nona in 2016 and Typhoons Tisoy and Ursula in 2020."
        )
    else:
        st.info("At least 4 observation years are required to compute statistical Z-score bounds.")
    render_view_footer("ANOMALIES_SCATTER")

def render_anomalies_table_view():
    render_view_header("ANOMALIES_TABLE")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>⚠️ Summary Table of Flagged Statistical Anomaly Years</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 4:
        anom_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        anom_df = detect_statistical_anomalies(anom_base, z_thresh=1.4)
        flagged_rows = anom_df[anom_df['Anomaly_Flag'] != 'Normal Production']
        if not flagged_rows.empty:
            display_flags = flagged_rows[['Year', 'Volume_MT', 'Z_Score', 'Anomaly_Flag']].copy()
            st.dataframe(
                display_flags.style.format({'Volume_MT': '{:,.2f}', 'Z_Score': '{:+.2f}'}),
                use_container_width=True,
                column_config={
                    "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
                    "Volume_MT": st.column_config.NumberColumn("Harvest Volume (Metric Tons)", format="%,.2f MT"),
                    "Z_Score": st.column_config.NumberColumn("Standardized Z-Score", format="%+.2f"),
                    "Anomaly_Flag": st.column_config.TextColumn("Statistical Classification")
                }
            )
            render_explanation(
                "Flagged Anomaly Summary Table",
                "This table lists the specific calendar years that were flagged as statistically unusual within your active filter selection. "
                "For each flagged year, it shows the recorded harvest volume, the calculated statistical Z-score, and whether the event was classified as an unusually high boom or an unusually severe shock. "
                "Agricultural officers can use this information to correlate extreme events with historical weather records and pest outbreaks."
            )
        else:
            st.success("All observed production years in this selection remain within standard statistical variance bounds (between -1.4σ and +1.4σ).")
    else:
        st.info("At least 4 observation years are required to compute statistical Z-score bounds.")
    render_view_footer("ANOMALIES_TABLE")

def render_forecasting_chart_view():
    render_view_header("FORECAST_CHART")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>🔮 Exploratory Time-Series Production Forecast (Holt's Linear Smoothing)</div>", unsafe_allow_html=True)
    st.markdown("""
    <div class="warning-banner">
        ⚠️ <b>Academic Disclaimer & Methodological Note:</b><br>
        The projections generated below are <b>exploratory statistical estimates</b> calculated using 
        Double Exponential Smoothing (Holt's Linear Trend Model). They are designed for scenario planning and research exercises, 
        and should <b>not be treated as certified actual production figures</b>.
    </div>
    """, unsafe_allow_html=True)

    fc_horizon = st.slider("Select Forecast Horizon (Years into the future):", min_value=2, max_value=5, value=4)
    fc_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
    
    forecast_results = run_time_series_forecast(fc_base, train_ratio=0.8, forecast_horizon=fc_horizon)

    if forecast_results is not None:
        metrics = forecast_results['eval_metrics']
        train_df = forecast_results['train_df']
        test_df = forecast_results['test_df']
        future_df = forecast_results['forecast_df']

        f1, f2, f3 = st.columns(3)
        with f1:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--leaf-green);">
                <div class="growth-kpi-label">Mean Absolute Error (MAE)</div>
                <div class="growth-kpi-val">{metrics['MAE_MT']/1e3:,.1f}K <span class="unit-text">MT</span></div>
                <div class="growth-kpi-sub">Average magnitude of forecast error</div>
            </div>
            """, unsafe_allow_html=True)
        with f2:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--forest-green);">
                <div class="growth-kpi-label">Root Mean Squared Error (RMSE)</div>
                <div class="growth-kpi-val">{metrics['RMSE_MT']/1e3:,.1f}K <span class="unit-text">MT</span></div>
                <div class="growth-kpi-sub">Standard deviation of residuals</div>
            </div>
            """, unsafe_allow_html=True)
        with f3:
            st.markdown(f"""
            <div class="growth-kpi-card" style="border-left-color: var(--banana-yellow);">
                <div class="growth-kpi-label">Mean Absolute % Error (MAPE)</div>
                <div class="growth-kpi-val">{metrics['MAPE_Pct']:.2f}%</div>
                <div class="growth-kpi-sub">Test accuracy (< 10% is highly accurate)</div>
            </div>
            """, unsafe_allow_html=True)

        st.caption(f"🧪 **Validation Setup:** Trained on {metrics['Train_Years']} • Evaluated on held-out test data from {metrics['Test_Years']}.")

        fig_fc = go.Figure()
        fig_fc.add_trace(go.Scatter(
            x=train_df['Year'], y=train_df['Volume_MT'],
            mode='lines+markers', name='Historical Training Data',
            line=dict(color='#055922', width=2.8), marker=dict(size=7, color='#055922')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Volume_MT'],
            mode='lines+markers', name='Actual Test Data (Holdout)',
            line=dict(color='#849B0F', width=2.8), marker=dict(size=8, symbol='diamond', color='#849B0F')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Predicted_MT'],
            mode='lines+markers', name='Model Test Predictions',
            line=dict(color='#D78601', width=2, dash='dot'), marker=dict(size=7, symbol='cross', color='#D78601')
        ))
        fig_fc.add_trace(go.Scatter(
            x=future_df['Year'], y=future_df['Projected_MT'],
            mode='lines+markers', name='Exploratory Estimate (Forecast)',
            line=dict(color='#FBE05A', width=3, dash='dash'),
            marker=dict(size=9, symbol='star', color='#FBE05A', line=dict(color='#055922', width=1.5))
        ))
        fig_fc.add_trace(go.Scatter(
            x=list(future_df['Year']) + list(future_df['Year'])[::-1],
            y=list(future_df['Upper_CI_MT']) + list(future_df['Lower_CI_MT'])[::-1],
            fill='toself', fillcolor='rgba(251, 224, 90, 0.28)',
            line=dict(color='rgba(215, 134, 1, 0.3)', width=1, dash='dot'),
            hoverinfo="skip", showlegend=True, name='95% Confidence Interval Band'
        ))
        fig_fc.update_layout(
            **PLOT_THEME,
            height=520,
            xaxis_title="Calendar Year",
            yaxis_title="Volume of Production (Metric Tons)",
            hovermode="x unified",
            margin=dict(l=60, r=30, t=60, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,244,0.9)")
        )
        fig_fc.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=10)
        fig_fc.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=10)
        st.plotly_chart(fig_fc, use_container_width=True)
        render_explanation(
            "Exploratory Time-Series Production Forecast",
            "This chart displays exploratory future production projections calculated using Holt's Linear Exponential Smoothing method. "
            "The dark green line shows the historical data used to train the model, the lighter green line shows held-out test data used to evaluate accuracy, and the dashed yellow line shows estimated future production. "
            "The shaded yellow band represents the 95% confidence interval, indicating the statistical range of likely future outcomes based on historical volatility."
        )
    else:
        st.warning("Insufficient continuous historical observations to train the time-series model. Please expand your year selection.")
    render_view_footer("FORECAST_CHART")

def render_forecasting_table_view():
    render_view_header("FORECAST_TABLE")
    st.markdown("<div style='font-family: Playfair Display, serif; font-size: 1.35rem; font-weight: 700; color: #055922; margin: 16px 0 12px 0;'>📋 Projected Future Estimates (Exploratory Scenario Table)</div>", unsafe_allow_html=True)
    fc_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
    forecast_results = run_time_series_forecast(fc_base, train_ratio=0.8, forecast_horizon=4)
    if forecast_results is not None:
        future_df = forecast_results['forecast_df']
