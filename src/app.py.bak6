    }
    .kpi-subtext-rect {
        font-size: 0.86rem;
        color: #556e26;
        margin-top: 8px;
        font-weight: 600;
    }

    /* ---------------- CLEAN METRIC CARDS (GROWTH SECTION) ---------------- */
    .growth-kpi-card {
        background: var(--cream-card);
        border-radius: 16px;
        box-shadow: 6px 6px 14px var(--shadow-dark), -6px -6px 14px var(--shadow-light);
        border: 1px solid rgba(255, 255, 255, 0.85);
