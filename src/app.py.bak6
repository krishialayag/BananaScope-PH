    /* ---------------- STREAMLIT BUTTON OVERRIDES (NEUMORPHIC) ---------------- */
    /* Primary Action Buttons (Yellow Neumorphic Extruded) */
    button[kind="primary"] {
        background: linear-gradient(145deg, #FFF388 0%, #FBE05A 100%) !important;
        color: var(--forest-green) !important;
        border-radius: 16px !important;
        box-shadow: 5px 5px 12px var(--shadow-dark), -5px -5px 12px var(--shadow-light) !important;
        border: 1px solid rgba(255, 255, 255, 0.8) !important;
