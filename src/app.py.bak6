        border-radius: 20px;
        box-shadow: 3px 3px 8px var(--shadow-dark), -3px -3px 8px var(--shadow-light);
    }

    /* ---------------- ENLARGED 2x2 KPI CARDS ---------------- */
    .kpi-card-rect {
        background: var(--cream-card);
        border-radius: 20px;
        box-shadow: 7px 7px 18px var(--shadow-dark), -7px -7px 18px var(--shadow-light);
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        padding: 22px 26px;
        margin-bottom: 20px;
        min-height: 150px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .kpi-card-rect:hover {
        transform: translateY(-2px);
        box-shadow: 9px 9px 22px rgba(215, 134, 1, 0.2), -9px -9px 22px var(--shadow-light);
    }
    .kpi-card-rect.accent-yellow {
        border-top: 6px solid var(--banana-yellow);
    }
    .kpi-card-rect.accent-forest {
        border-top: 6px solid var(--forest-green);
    }
    .kpi-card-rect.accent-orange {
        border-top: 6px solid var(--golden-orange);
    }
    .kpi-card-rect.accent-leaf {
        border-top: 6px solid var(--leaf-green);
    }
    .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .kpi-label-rect {
        font-size: 0.90rem;
        font-weight: 800;
        color: var(--olive-green);
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }
    .kpi-icon-rect {
        font-size: 1.45rem;
        background: var(--cream-inset);
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        box-shadow: inset 2px 2px 5px rgba(215, 134, 1, 0.15), inset -2px -2px 5px rgba(255, 255, 255, 0.9);
    }
    .kpi-value-rect {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 2.35rem;
        font-weight: 800;
        color: var(--forest-green);
        margin: 0;
        line-height: 1.15;
    }
    .kpi-value-rect .unit-text {
        font-size: 1.10rem;
        font-weight: 700;
        color: var(--leaf-green);
