        text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.9);
    }
    .hero-subtitle {
        font-size: 1.05rem;
        color: #496323;
        margin: 6px 0 0 0;
        font-weight: 600;
    }
    .hero-badges-container {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }
    .hero-pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #FFFDF4;
        border: 1px solid rgba(215, 134, 1, 0.25);
