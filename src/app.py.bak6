    /* Dataframe Table Container */
    [data-testid="stDataFrame"] {
        background: #FFFDF8 !important;
        border-radius: 18px !important;
        box-shadow: 6px 6px 16px var(--shadow-dark), -6px -6px 16px var(--shadow-light) !important;
