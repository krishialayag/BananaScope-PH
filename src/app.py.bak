    calculate_cagr,
    compute_trend_models,
    detect_statistical_anomalies,
    run_time_series_forecast
)

# -----------------------------------------------------------------------------
# 1. PAGE CONFIGURATION & AGRICULTURAL GREEN/WHITE STYLING
# -----------------------------------------------------------------------------
st.set_page_config(
    page_title="BananaScope PH | Advanced Agricultural Analytics",
    page_icon="🍌",
    layout="wide",
    initial_sidebar_state="expanded"
