        </h1>
        <p class="hero-subtitle">
            Philippine Banana Production Analytics Platform (2010–2026)
        </p>
        <div class="hero-badges-container">
            <span class="hero-pill-badge">🌾 Official PSA OpenStat Data</span>
            <span class="hero-pill-badge">🌿 15-Year Longitudinal Scope</span>
            <span class="hero-pill-badge">🏛️ DepEd MIMAROPA Capstone</span>
        </div>
    </div>
    """, unsafe_allow_html=True)

    # 2. Concise Surveillance Summary Callout
    if not active_df.empty and len(yearly_totals) > 1:
        start_y = yearly_totals.index.min()
        end_y = yearly_totals.index.max()
        v_start = yearly_totals.loc[start_y]
        v_end = yearly_totals.loc[end_y]
        pct_change = ((v_end - v_start) / v_start) * 100 if v_start > 0 else 0
        cagr_val = calculate_cagr(v_start, v_end, end_y - start_y)
        dir_text = "net expansion" if pct_change >= 0 else "net contraction"
        
        st.markdown(f"""
        <div class="insights-card">
            <div class="insights-title">💡 Production Surveillance Overview: {geo_label}</div>
            <div class="insights-body">
                Between <b>{start_y}</b> and <b>{end_y}</b>, banana production in <b>{geo_label}</b> recorded a 
                <b>{dir_text} of {abs(pct_change):.1f}%</b> (CAGR: <b>{cagr_val:+.2f}%/yr</b>). 
                Peak production reached <b>{peak_vol_mt/1e3:,.1f}K MT in {peak_year}</b>, while lowest recorded volume was 
                <b>{lowest_vol_mt/1e3:,.1f}K MT in {lowest_year}</b>.
            </div>
        </div>
        """, unsafe_allow_html=True)

    # 3. STRICT 2 × 2 EQUAL-SIZED KPI CARDS (All 4 cards have exactly identical height & width)
    row1_c1, row1_c2 = st.columns(2)
    with row1_c1:
        st.markdown(f"""
        <div class="kpi-card-rect accent-green">
            <div class="kpi-header">
                <span class="kpi-label-rect">Total Production Volume</span>
                <span class="kpi-icon-rect">🍌</span>
            </div>
            <div class="kpi-value-rect">{total_production_mt/1e6:.2f}M <span class="unit-text">MT</span></div>
            <div class="kpi-subtext-rect">📍 Scope: {geo_label} ({total_production_mt:,.0f} MT)</div>
        </div>
        """, unsafe_allow_html=True)

    with row1_c2:
        st.markdown(f"""
        <div class="kpi-card-rect accent-yellow">
            <div class="kpi-header">
                <span class="kpi-label-rect">Average Annual Production</span>
                <span class="kpi-icon-rect">⚖️</span>
            </div>
            <div class="kpi-value-rect">{avg_annual_mt/1e6:.2f}M <span class="unit-text">MT / yr</span></div>
            <div class="kpi-subtext-rect">📅 Average across {selected_years[1] - selected_years[0] + 1} years ({selected_years[0]}–{selected_years[1]})</div>
        </div>
        """, unsafe_allow_html=True)

    row2_c1, row2_c2 = st.columns(2)
    with row2_c1:
        st.markdown(f"""
        <div class="kpi-card-rect accent-peach">
            <div class="kpi-header">
                <span class="kpi-label-rect">Peak Harvest Year</span>
                <span class="kpi-icon-rect">🏆</span>
            </div>
            <div class="kpi-value-rect">{peak_year}</div>
            <div class="kpi-subtext-rect">📈 Peak: {peak_vol_mt/1e6:.2f}M MT (Lowest: {lowest_vol_mt/1e6:.2f}M in {lowest_year})</div>
        </div>
        """, unsafe_allow_html=True)

    with row2_c2:
        st.markdown(f"""
        <div class="kpi-card-rect accent-butter">
            <div class="kpi-header">
                <span class="kpi-label-rect">Leading Banana Region</span>
                <span class="kpi-icon-rect">🗺️</span>
            </div>
            <div class="kpi-value-rect" style="font-size: 1.70rem;">{top_region_name}</div>
            <div class="kpi-subtext-rect">🌾 Output: {top_region_vol/1e6:.2f}M MT (54% National Share)</div>
        </div>
        """, unsafe_allow_html=True)

    # 4. COMPACT & ALIGNED ANALYTICS NAVIGATION HUB
    st.markdown("""
    <div style="background: var(--card-white); border-radius: 14px; border: 1px solid rgba(255, 213, 79, 0.4); border-left: 4px solid var(--sunlit-green); padding: 10px 16px; margin: 12px 0 10px 0; box-shadow: 2px 2px 8px rgba(163, 180, 84, 0.10);">
        <div style="font-size: 0.90rem; font-weight: 800; color: #3E2723; display: flex; align-items: center; gap: 6px;">
            <span>🧭</span> Analytics Navigation Menu
        </div>
        <div style="font-size: 0.78rem; color: #6D5545; margin-top: 2px;">
            Select any section below to open it in a dedicated single-view screen equipped with Home, Back, and Next buttons.
        </div>
    </div>
    """, unsafe_allow_html=True)

    # Category 1: Production Overview & Seasonality
    st.markdown("""
    <div class="category-group-card">
        <div class="category-group-header">
            <span>📈</span> 1. Production Overview & Seasonality
        </div>
    </div>
    """, unsafe_allow_html=True)
    c1, c2 = st.columns(2)
    with c1:
        if st.button("📈 Annual Production Trajectory", key="home_btn_annual", type="primary", use_container_width=True):
            st.session_state.active_view = "ANNUAL_TRAJECTORY"
            st.rerun()
    with c2:
        if st.button("⏱️ Quarterly Harvest Patterns", key="home_btn_quarterly", type="secondary", use_container_width=True):
            st.session_state.active_view = "QUARTERLY_SEASONALITY"
            st.rerun()

    # Category 2: Regional & Geographic Rankings
    st.markdown("""
    <div class="category-group-card" style="margin-top: 8px;">
        <div class="category-group-header">
            <span>🗺️</span> 2. Regional & Geographic Rankings
        </div>
    </div>
    """, unsafe_allow_html=True)
    c3, _ = st.columns([1, 1])
    with c3:
        if st.button("🗺️ Regional Production Comparison", key="home_btn_regional", type="primary", use_container_width=True):
            st.session_state.active_view = "REGIONAL_RANKINGS"
            st.rerun()

    # Category 3: Banana Variety Analysis
    st.markdown("""
    <div class="category-group-card" style="margin-top: 8px;">
        <div class="category-group-header">
            <span>🍌</span> 3. Banana Variety Analysis
        </div>
    </div>
    """, unsafe_allow_html=True)
    c4, c5 = st.columns(2)
    with c4:
        if st.button("🍌 Variety Market Share", key="home_btn_cultivar", type="primary", use_container_width=True):
            st.session_state.active_view = "CULTIVAR_DONUT"
            st.rerun()
    with c5:
        if st.button("🌿 Variety Multi-Year Trends", key="home_btn_variety_trends", type="secondary", use_container_width=True):
            st.session_state.active_view = "VARIETY_COMPARISON"
            st.rerun()

    # Category 4: Growth Rates, Trendlines & Forecasting
    st.markdown("""
    <div class="category-group-card" style="margin-top: 8px;">
        <div class="category-group-header">
            <span>📊</span> 4. Growth Rates, Trendlines & Forecasting
        </div>
    </div>
    """, unsafe_allow_html=True)
    c6, c7, c8, c9 = st.columns(4)
    with c6:
        if st.button("📊 YoY % Growth", key="home_btn_yoy", type="primary", use_container_width=True):
            st.session_state.active_view = "YOY_GROWTH"
            st.rerun()
    with c7:
        if st.button("🌾 3-Yr Trendline", key="home_btn_smooth", type="secondary", use_container_width=True):
            st.session_state.active_view = "MOVING_AVERAGE"
            st.rerun()
    with c8:
        if st.button("🔍 Anomaly Shocks", key="home_btn_anom_scatter", type="secondary", use_container_width=True):
            st.session_state.active_view = "ANOMALIES_SCATTER"
            st.rerun()
    with c9:
        if st.button("🔮 Future Forecast", key="home_btn_fc_chart", type="primary", use_container_width=True):
            st.session_state.active_view = "FORECAST_CHART"
            st.rerun()

    # Category 5: Structured Tables & Methodology
    st.markdown("""
    <div class="category-group-card" style="margin-top: 8px;">
        <div class="category-group-header">
            <span>📑</span> 5. Structured Tables & Methodology
        </div>
    </div>
    """, unsafe_allow_html=True)
    c10, c11, c12, c13 = st.columns(4)
    with c10:
        if st.button("📋 Forecast Table", key="home_btn_fc_table", type="secondary", use_container_width=True):
            st.session_state.active_view = "FORECAST_TABLE"
            st.rerun()
    with c11:
        if st.button("⚠️ Anomaly Table", key="home_btn_anom_table", type="secondary", use_container_width=True):
            st.session_state.active_view = "ANOMALIES_TABLE"
            st.rerun()
    with c12:
        if st.button("📑 Records Explorer", key="home_btn_records", type="primary", use_container_width=True):
            st.session_state.active_view = "RECORDS_TABLE"
            st.rerun()
    with c13:
        if st.button("📐 Methodology", key="home_btn_math", type="secondary", use_container_width=True):
            st.session_state.active_view = "MATH_METHODOLOGY"
            st.rerun()


# =============================================================================
# 9. VIEW ROUTER (DISPATCHES ONLY THE ACTIVE SINGLE VIEW)
# =============================================================================
elif st.session_state.active_view == "ANNUAL_TRAJECTORY":
    render_annual_trajectory_view()

elif st.session_state.active_view == "QUARTERLY_SEASONALITY":
    render_quarterly_seasonality_view()

elif st.session_state.active_view == "REGIONAL_RANKINGS":
    render_regional_rankings_view()

elif st.session_state.active_view == "CULTIVAR_DONUT":
    render_cultivar_donut_view()

elif st.session_state.active_view == "VARIETY_COMPARISON":
    render_variety_comparison_view()

elif st.session_state.active_view == "YOY_GROWTH":
    render_yoy_growth_view()

elif st.session_state.active_view == "MOVING_AVERAGE":
    render_moving_average_view()

elif st.session_state.active_view == "ANOMALIES_SCATTER":
    render_anomalies_scatter_view()

elif st.session_state.active_view == "FORECAST_CHART":
    render_forecasting_chart_view()

elif st.session_state.active_view == "FORECAST_TABLE":
    render_forecasting_table_view()

elif st.session_state.active_view == "ANOMALIES_TABLE":
    render_anomalies_table_view()

elif st.session_state.active_view == "RECORDS_TABLE":
    render_records_table_view()

elif st.session_state.active_view == "MATH_METHODOLOGY":
    render_math_methodology_view()

else:
    st.session_state.active_view = "HOME"
    st.rerun()


