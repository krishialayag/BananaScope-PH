        <div class="kpi-value-large">{total_production_mt/1e6:.2f}M <span class="unit-text">Metric Tons</span></div>
        <div class="kpi-subtext-large">📍 Geographic Scope: <b>{geo_label}</b></div>
    </div>
    """, unsafe_allow_html=True)

with row1_c2:
    st.markdown(f"""
    <div class="kpi-card-large accent-forest">
        <div class="kpi-header">
            <span class="kpi-label-large">Average Annual Production</span>
            <span class="kpi-icon-large">⚖️</span>
        </div>
        <div class="kpi-value-large">{avg_annual_mt/1e6:.2f}M <span class="unit-text">Metric Tons / Year</span></div>
        <div class="kpi-subtext-large">📅 Computed across <b>{selected_years[1] - selected_years[0] + 1} calendar years</b> ({selected_years[0]}–{selected_years[1]})</div>
