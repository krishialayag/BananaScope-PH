        <div class="kpi-header">
            <span class="kpi-label-large">Highest Production Year (Peak)</span>
            <span class="kpi-icon-large">🏆</span>
        </div>
        <div class="kpi-value-large">{peak_year}</div>
        <div class="kpi-subtext-large">📈 Recorded Peak Volume: <b>{peak_vol_mt/1e6:.2f}M MT</b> (Lowest: {lowest_vol_mt/1e6:.2f}M MT in {lowest_year})</div>
    </div>
    """, unsafe_allow_html=True)

with row2_c2:
