def show_annual_trajectory_chart():
    st.markdown("<div class='section-title'>📈 Annual Banana Production Trajectory (Metric Tons)</div>", unsafe_allow_html=True)
    if not active_df.empty:
        annual_plot_data = active_df.groupby(['Year', 'Crop'])['Volume_MT'].sum().reset_index()
        fig_traj = px.line(
            annual_plot_data, x='Year', y='Volume_MT', color='Crop',
            markers=True, line_shape='spline',
            color_discrete_sequence=['#214D32', '#387A45', '#F4C542', '#8B5E3C', '#D4A017', '#5C8247'],
            labels={'Volume_MT': 'Volume (Metric Tons)', 'Year': 'Calendar Year'}
        )
        fig_traj.update_layout(
            **PLOT_THEME,
            hovermode="x unified",
            margin=dict(l=25, r=25, t=35, b=25),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_traj.update_yaxes(gridcolor='#EADBCA', zerolinecolor='#8B5E3C')
        fig_traj.update_xaxes(gridcolor='#EADBCA', dtick=1)
        st.plotly_chart(fig_traj, use_container_width=True)
        render_explanation(
            "Annual Production Trajectory",
            "This line chart shows the total volume of bananas harvested each year across your selected geographic area and banana varieties. "
            "It allows viewers to easily see whether production has been rising, falling, or remaining stable over the 15-year historical timeline. "
            "For national figures, notice the expansion up to the 2018 historical peak followed by a continuous contraction in recent years."
        )

def show_quarterly_seasonality_chart():
    st.markdown("<div class='section-title'>⏱️ Seasonal Quarterly Harvest Patterns (Q1–Q4 Comparison)</div>", unsafe_allow_html=True)
    q_subset = df[(df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & (df['Period_Type'] == 'Quarterly') & (df['Crop'].isin(selected_varieties))]
    if selected_province != all_prov_opt:
        q_subset = q_subset[q_subset['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        q_subset = q_subset[(q_subset['Region'] == selected_region) & (q_subset['Hierarchy_Level'] == 'Regional')]
    else:
        q_subset = q_subset[q_subset['Hierarchy_Level'] == 'National']

    if not q_subset.empty:
        q_agg = q_subset.groupby('Period')['Volume_MT'].mean().reindex(['Q1', 'Q2', 'Q3', 'Q4']).reset_index()
        fig_q = px.bar(
            q_agg, x='Period', y='Volume_MT', color='Period',
            color_discrete_sequence=['#8B5E3C', '#387A45', '#F4C542', '#214D32'],
            labels={'Volume_MT': 'Average Volume (Metric Tons)', 'Period': 'Quarter'},
            text_auto='.2s'
        )
        fig_q.update_traces(
            marker_line_color='#214D32', marker_line_width=1,
            textposition='outside', cliponaxis=False
        )
        fig_q.update_layout(
            **PLOT_THEME,
            showlegend=False,
            margin=dict(l=25, r=25, t=35, b=25)
        )
        fig_q.update_yaxes(gridcolor='#EADBCA')
        fig_q.update_xaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_q, use_container_width=True)
        render_explanation(
            "Quarterly Harvest Seasonality",
            "This bar chart compares average banana production across the four calendar quarters to highlight seasonal harvesting rhythms. "
            "The data clearly demonstrates that Quarter 1 (January to March) consistently experiences the lowest harvest volume of the year, "
            "while Quarters 2, 3, and 4 maintain a stable, high-volume production plateau. "
            "Farmers, cooperatives, and buyers can use this seasonal pattern to prepare for annual supply swings and market price adjustments."
        )

def show_regional_rankings_chart():
    st.markdown("<div class='section-title'>🗺️ Regional Banana Production Comparison Across the Philippines</div>", unsafe_allow_html=True)
    reg_data = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Hierarchy_Level'] == 'Regional') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly')) &
        (df['Crop'].isin(selected_varieties))
    ].groupby('Region')['Volume_MT'].sum().reset_index().sort_values('Volume_MT', ascending=True)

    if not reg_data.empty:
        reg_data['Clean_Region'] = reg_data['Region'].str.replace(r'REGION [IVX]+ \((.*?)\)', r'\1', regex=True)
        fig_reg = px.bar(
            reg_data, x='Volume_MT', y='Clean_Region', orientation='h',
            color='Volume_MT', color_continuous_scale=['#FFF8E7', '#F4C542', '#387A45', '#214D32'],
            labels={'Volume_MT': 'Total Production (Metric Tons)', 'Clean_Region': 'Administrative Region'}
        )
        fig_reg.update_traces(marker_line_color='#214D32', marker_line_width=0.8)
        fig_reg.update_layout(
            **PLOT_THEME,
            coloraxis_showscale=False,
            margin=dict(l=25, r=25, t=30, b=25)
        )
        fig_reg.update_yaxes(gridcolor='#EADBCA')
        fig_reg.update_xaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_reg, use_container_width=True)
        render_explanation(
            "Regional Production Comparison",
            "This horizontal bar chart ranks Philippine administrative regions from highest to lowest based on total banana output. "
            "It highlights the significant concentration of production in Mindanao, where Davao Region, Northern Mindanao, and SOCCSKSARGEN "
            "account for over 76% of all Philippine bananas. "
            "Island regions like MIMAROPA produce smaller national shares that remain vital for provincial food security."
        )

def show_cultivar_donut_chart():
    st.markdown("<div class='section-title'>🍌 Market Share Breakdown by Banana Variety</div>", unsafe_allow_html=True)
    cult_df = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Crop'] != 'Banana (Total)') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly'))
    ]
    if selected_province != all_prov_opt:
        cult_df = cult_df[cult_df['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        cult_df = cult_df[(cult_df['Region'] == selected_region) & (cult_df['Hierarchy_Level'] == 'Regional')]
    else:
        cult_df = cult_df[cult_df['Hierarchy_Level'] == 'National']

    if not cult_df.empty:
        cult_agg = cult_df.groupby('Crop')['Volume_MT'].sum().reset_index()
        cult_agg['Crop_Name'] = cult_agg['Crop'].str.replace('Banana ', '')
        fig_donut = px.pie(
            cult_agg, names='Crop_Name', values='Volume_MT', hole=0.48,
            color_discrete_sequence=['#F4C542', '#387A45', '#214D32', '#8B5E3C', '#D4A017', '#5C8247']
        )
        fig_donut.update_traces(
            marker=dict(line=dict(color='#FFFDF8', width=2)),
            textposition='outside', textinfo='percent+label'
        )
        fig_donut.update_layout(
            **PLOT_THEME,
            margin=dict(l=25, r=25, t=30, b=25),
            legend=dict(orientation="h", yanchor="bottom", y=-0.25, xanchor="center", x=0.5)
        )
        st.plotly_chart(fig_donut, use_container_width=True)
        render_explanation(
            "Cultivar Market Composition",
            "This donut chart displays the percentage share of each major banana variety in total recorded production. "
            "Cavendish (grown primarily for international export) and Saba (used widely for local cooking and banana chips) "
            "together make up roughly 80% of all bananas grown in the country. "
            "Popular table dessert varieties like Lakatan and Latundan account for most of the remaining domestic harvest."
        )

def show_records_table():
    st.markdown("<div class='section-title'>📋 Official Banana Production Records Explorer</div>", unsafe_allow_html=True)
    table_display = active_df[['Year', 'Period', 'Crop', 'Region', 'Province_City', 'Volume_MT', 'Data_Status']].sort_values(by=['Year', 'Crop'], ascending=[False, True])
    st.dataframe(
        table_display.style.format({'Volume_MT': '{:,.2f}'}),
        use_container_width=True,
        height=340,
        column_config={
            "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
            "Period": st.column_config.TextColumn("Reporting Period"),
            "Crop": st.column_config.TextColumn("Banana Variety"),
            "Region": st.column_config.TextColumn("Administrative Region"),
            "Province_City": st.column_config.TextColumn("Province / City"),
            "Volume_MT": st.column_config.NumberColumn("Volume (Metric Tons)", format="%,.2f MT"),
            "Data_Status": st.column_config.TextColumn("Data Audit Status")
        }
    )
    render_explanation(
        "Production Records Table",
        "This interactive table presents the verified statistical production records matching your active filter selections. "
        "You can sort any column by clicking its header, search for specific terms, or download the filtered dataset as a spreadsheet using the button below. "
        "This feature is especially useful for municipal planners and researchers who require exact numbers for agricultural reporting."
    )
    csv_bytes = table_display.to_csv(index=False).encode('utf-8')
    st.download_button(
        "📥 Download Filtered Records as CSV",
        data=csv_bytes,
        file_name=f"bananascope_filtered_{selected_years[0]}_{selected_years[1]}.csv",
        mime="text/csv"
    )

def show_growth_and_trends_charts():
    st.markdown("<div class='section-title'>📊 Year-over-Year (YoY) Growth & Longitudinal Trend Modeling</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 2:
        yoy_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        yoy_df = compute_yoy_growth(yoy_base)
        trend_df, t_stats = compute_trend_models(yoy_base)

        cagr_period = calculate_cagr(yoy_df['Volume_MT'].iloc[0], yoy_df['Volume_MT'].iloc[-1], len(yoy_df) - 1)
        mean_yoy = yoy_df['YoY_Growth_Pct'].dropna().mean()
        max_growth_row = yoy_df.loc[yoy_df['YoY_Growth_Pct'].idxmax()] if yoy_df['YoY_Growth_Pct'].notna().any() else None
        min_growth_row = yoy_df.loc[yoy_df['YoY_Growth_Pct'].idxmin()] if yoy_df['YoY_Growth_Pct'].notna().any() else None

        # Clean Metric Cards (NO DOTS, CLEAN READABLE NUMBERS)
        m1, m2, m3, m4 = st.columns(4)
        with m1:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Compound Annual Growth (CAGR)</div>
                <div class="trend-metric-val">{cagr_period:+.1f}%</div>
                <div class="trend-metric-sub">Smoothed Annualized Rate</div>
            </div>
            """, unsafe_allow_html=True)
        with m2:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Average Annual YoY Growth</div>
                <div class="trend-metric-val">{mean_yoy:+.1f}%</div>
                <div class="trend-metric-sub">Year-to-Year Mean Change</div>
            </div>
            """, unsafe_allow_html=True)
        with m3:
            max_pct = f"{max_growth_row['YoY_Growth_Pct']:+.1f}%" if max_growth_row is not None else "N/A"
            max_yr = f"In {int(max_growth_row['Year'])}" if max_growth_row is not None else ""
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Highest Single-Year Expansion</div>
                <div class="trend-metric-val">{max_pct}</div>
                <div class="trend-metric-sub">{max_yr}</div>
            </div>
            """, unsafe_allow_html=True)
        with m4:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Long-Term Linear Trend Slope</div>
                <div class="trend-metric-val">{t_stats['slope_mt_per_year']:+,.0f} <span style="font-size:0.95rem;font-weight:600;">MT/yr</span></div>
                <div class="trend-metric-sub">Ordinary Least Squares Slope</div>
            </div>
            """, unsafe_allow_html=True)

        # Simplified YoY Growth Rate Chart (Clean Labels, No Clutter)
        st.markdown("<div class='section-title'>📊 Annual Year-over-Year Percentage Growth (% Change)</div>", unsafe_allow_html=True)
        yoy_clean = yoy_df.dropna(subset=['YoY_Growth_Pct']).copy()
        yoy_clean['Growth_Color'] = np.where(yoy_clean['YoY_Growth_Pct'] >= 0, 'Expansion (+)', 'Contraction (-)')
        yoy_clean['Display_Text'] = yoy_clean['YoY_Growth_Pct'].apply(lambda x: f"{x:+.1f}%")

        fig_yoy = px.bar(
            yoy_clean, x='Year', y='YoY_Growth_Pct', color='Growth_Color',
            color_discrete_map={'Expansion (+)': '#387A45', 'Contraction (-)': '#8B5E3C'},
            labels={'YoY_Growth_Pct': 'Growth Rate (%)', 'Year': 'Calendar Year'},
            text='Display_Text'
        )
        fig_yoy.add_hline(y=0, line_dash="solid", line_color="#8B5E3C", line_width=1.5)
        fig_yoy.update_traces(
            textposition='outside', cliponaxis=False,
            textfont=dict(size=11, family="'Plus Jakarta Sans', sans-serif", color='#214D32'),
            marker_line_color='#214D32', marker_line_width=1
        )
        fig_yoy.update_layout(
            **PLOT_THEME,
            margin=dict(l=25, r=25, t=35, b=25),
            legend_title=""
        )
        fig_yoy.update_yaxes(gridcolor='#EADBCA', ticksuffix='%')
        fig_yoy.update_xaxes(gridcolor='#EADBCA', dtick=1)
        st.plotly_chart(fig_yoy, use_container_width=True)
        render_explanation(
            "Year-over-Year Percentage Growth",
            "This bar chart illustrates the annual percentage increase or decrease in banana production compared to the previous year. "
            "Upward green bars show years when production expanded, while downward brown bars indicate years when harvests contracted. "
            "This visualization enables users to immediately identify periods of rapid growth or sharp harvest drops without having to calculate percentages manually."
        )

        # Moving Average and Trendline Chart
        st.markdown("<div class='section-title'>🌾 Production Volume with 3-Year Rolling Average & Long-Term Trendline</div>", unsafe_allow_html=True)
        fig_smooth = go.Figure()
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Volume_MT'], mode='lines+markers',
            name='Actual Annual Output', line=dict(color='#214D32', width=3),
            marker=dict(size=7, color='#214D32')
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['SMA_3'], mode='lines',
            name='3-Year Moving Average (SMA-3)', line=dict(color='#387A45', width=2.5, dash='dot')
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Linear_Trend'], mode='lines',
            name=f"OLS Linear Trend (R² = {t_stats['r_squared']:.2f})", line=dict(color='#F4C542', width=2.5, dash='dash')
        ))
        fig_smooth.update_layout(
            **PLOT_THEME,
            hovermode="x unified",
            margin=dict(l=25, r=25, t=35, b=25),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_smooth.update_yaxes(gridcolor='#EADBCA')
        fig_smooth.update_xaxes(gridcolor='#EADBCA', dtick=1)
        st.plotly_chart(fig_smooth, use_container_width=True)
        render_explanation(
            "3-Year Moving Average & Trendline",
            "This chart combines actual annual production totals with a 3-year smoothed moving average and a straight linear trendline. "
            "The 3-year moving average smooths out temporary annual spikes or dips to highlight the true multi-year direction of production, "
            "while the straight dashed line illustrates the average historical rate of change in metric tons per year."
        )

        # Cultivar Trajectory Comparison Chart
        st.markdown("<div class='section-title'>🍌 Multi-Year Harvest Trends by Banana Variety</div>", unsafe_allow_html=True)
        multi_var_df = df[(df['Hierarchy_Level'] == 'National') & (df['Crop'] != 'Banana (Total)') & (df['Period_Type'] == 'Annual') & (df['Year'] <= selected_years[1]) & (df['Year'] >= selected_years[0])]
        if not multi_var_df.empty:
            fig_cult_growth = px.line(
                multi_var_df, x='Year', y='Volume_MT', color='Crop',
                markers=True, line_shape='spline',
                color_discrete_sequence=['#214D32', '#387A45', '#F4C542', '#8B5E3C', '#D4A017'],
                labels={'Volume_MT': 'Volume (Metric Tons)', 'Year': 'Calendar Year'}
            )
            fig_cult_growth.update_layout(
                **PLOT_THEME,
                margin=dict(l=25, r=25, t=35, b=25),
                legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
            )
            fig_cult_growth.update_yaxes(gridcolor='#EADBCA')
            fig_cult_growth.update_xaxes(gridcolor='#EADBCA', dtick=1)
            st.plotly_chart(fig_cult_growth, use_container_width=True)
            render_explanation(
                "Variety Trajectory Comparison",
                "This line chart tracks and compares the historical production volumes of individual banana varieties over time. "
                "It reveals how commercial export Cavendish experienced sharp declines after 2018 due to disease outbreaks, "
                "while domestic staple varieties like Saba exhibited greater resilience and stability across the same period."
            )
    else:
        st.warning("Insufficient continuous historical observations to compute growth models. Please expand your year horizon.")

def show_anomalies_and_shocks_view():
    st.markdown("<div class='section-title'>🔍 Statistical Detection of Extreme Harvests & Production Shocks (Z-Scores)</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 4:
        anom_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        anom_df = detect_statistical_anomalies(anom_base, z_thresh=1.4)

        fig_anom = px.scatter(
            anom_df, x='Year', y='Volume_MT', color='Anomaly_Flag',
            size=np.abs(anom_df['Z_Score']) + 2.0,
            color_discrete_map={
                'Normal Production': '#387A45',
                'Unusually High Output': '#F4C542',
                'Unusually Low Shock': '#8B5E3C',
                'Unrecorded': '#9ca3af'
            },
            labels={'Volume_MT': 'Harvest Volume (Metric Tons)', 'Year': 'Calendar Year'},
            text='Year'
        )
        fig_anom.update_traces(
            textposition='top center',
            marker=dict(line=dict(color='#214D32', width=1.5))
        )
        
        v_mean = anom_base['Volume_MT'].mean()
        v_std = anom_base['Volume_MT'].std()
        fig_anom.add_hline(y=v_mean, line_color="#214D32", line_width=2, annotation_text=f"Historical Mean: {v_mean/1e3:.1f}K MT")
        fig_anom.add_hline(y=v_mean + 1.4 * v_std, line_dash="dot", line_color="#F4C542", line_width=2, annotation_text="+1.4σ Upper Bound (Boom)")
        fig_anom.add_hline(y=max(0, v_mean - 1.4 * v_std), line_dash="dot", line_color="#8B5E3C", line_width=2, annotation_text="-1.4σ Lower Bound (Shock)")

        fig_anom.update_layout(
            **PLOT_THEME,
            margin=dict(l=25, r=25, t=35, b=25),
            legend_title="Statistical Classification"
        )
        fig_anom.update_yaxes(gridcolor='#EADBCA')
        fig_anom.update_xaxes(gridcolor='#EADBCA', dtick=1)
        st.plotly_chart(fig_anom, use_container_width=True)
        render_explanation(
            "Statistical Anomaly & Shock Detection",
            "This scatter plot uses standardized statistical scores (Z-scores) to objectively identify unusual harvest years that deviated significantly from normal historical levels. "
            "Data points falling below the lower dotted line represent severe agricultural shock years—such as major typhoon damage or severe droughts—while points above the upper dotted line indicate exceptional harvest booms. "
            "In Oriental Mindoro, for instance, this chart clearly flags the severe harvest drops following Typhoon Nona (2016) and Typhoons Tisoy and Ursula (2020)."
        )

        flagged_rows = anom_df[anom_df['Anomaly_Flag'] != 'Normal Production']
        if not flagged_rows.empty:
            st.markdown("<div class='section-title'>⚠️ Summary Table of Flagged Statistical Anomaly Years</div>", unsafe_allow_html=True)
            display_flags = flagged_rows[['Year', 'Volume_MT', 'Z_Score', 'Anomaly_Flag']].copy()
            st.dataframe(
                display_flags.style.format({'Volume_MT': '{:,.2f}', 'Z_Score': '{:+.2f}'}),
                use_container_width=True,
                column_config={
                    "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
                    "Volume_MT": st.column_config.NumberColumn("Harvest Volume (Metric Tons)", format="%,.2f MT"),
                    "Z_Score": st.column_config.NumberColumn("Standardized Z-Score", format="%+.2f"),
                    "Anomaly_Flag": st.column_config.TextColumn("Statistical Classification")
                }
            )
            render_explanation(
                "Anomaly Summary Table",
                "This table lists the specific calendar years that were classified as statistically unusual within your current filter scope. "
                "For each flagged observation, it provides the recorded harvest volume, the calculated Z-score, and whether it was an unusually high harvest or an unusually severe production shock."
            )
        else:
            st.success("All observed production years in this selection remain within standard statistical variance bounds (between -1.4σ and +1.4σ).")
    else:
        st.info("At least 4 observation years are required to compute statistical Z-score bounds.")

def show_forecasting_view():
    st.markdown("<div class='section-title'>🔮 Exploratory Time-Series Production Forecast (Holt's Linear Smoothing)</div>", unsafe_allow_html=True)
    st.markdown("""
    <div class="warning-banner">
        ⚠️ <b>Academic Disclaimer & Methodological Note:</b><br>
        The projections generated below are <b>exploratory statistical estimates</b> calculated using 
        Double Exponential Smoothing (Holt's Linear Trend Model). They are designed for scenario planning and research exercises, 
        and should <b>not be treated as certified actual production figures</b>.
    </div>
    """, unsafe_allow_html=True)

    fc_horizon = st.slider("Select Forecast Horizon (Years into the future):", min_value=2, max_value=5, value=4)
    fc_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
    
    forecast_results = run_time_series_forecast(fc_base, train_ratio=0.8, forecast_horizon=fc_horizon)

    if forecast_results is not None:
        metrics = forecast_results['eval_metrics']
        train_df = forecast_results['train_df']
        test_df = forecast_results['test_df']
        future_df = forecast_results['forecast_df']

        f1, f2, f3 = st.columns(3)
        with f1:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Mean Absolute Error (MAE)</div>
                <div class="trend-metric-val">{metrics['MAE_MT']/1e3:,.1f}K <span style="font-size:0.95rem;font-weight:600;">MT</span></div>
                <div class="trend-metric-sub">Average Magnitude of Forecast Error</div>
            </div>
            """, unsafe_allow_html=True)
        with f2:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Root Mean Squared Error (RMSE)</div>
                <div class="trend-metric-val">{metrics['RMSE_MT']/1e3:,.1f}K <span style="font-size:0.95rem;font-weight:600;">MT</span></div>
                <div class="trend-metric-sub">Standard Deviation of Residuals</div>
            </div>
            """, unsafe_allow_html=True)
        with f3:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Mean Absolute % Error (MAPE)</div>
                <div class="trend-metric-val">{metrics['MAPE_Pct']:.2f}%</div>
                <div class="trend-metric-sub">Test Accuracy (< 10% is Highly Accurate)</div>
            </div>
            """, unsafe_allow_html=True)

        st.caption(f"🧪 **Validation Setup:** Trained on {metrics['Train_Years']} • Evaluated on held-out test data from {metrics['Test_Years']}.")

        fig_fc = go.Figure()
        fig_fc.add_trace(go.Scatter(
            x=train_df['Year'], y=train_df['Volume_MT'],
            mode='lines+markers', name='Historical Training Data',
            line=dict(color='#214D32', width=2.8), marker=dict(size=7, color='#214D32')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Volume_MT'],
            mode='lines+markers', name='Actual Test Data (Holdout)',
            line=dict(color='#387A45', width=2.8), marker=dict(size=8, symbol='diamond', color='#387A45')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Predicted_MT'],
            mode='lines+markers', name='Model Test Predictions',
            line=dict(color='#8B5E3C', width=2, dash='dot'), marker=dict(size=7, symbol='cross', color='#8B5E3C')
        ))
        fig_fc.add_trace(go.Scatter(
            x=future_df['Year'], y=future_df['Projected_MT'],
            mode='lines+markers', name='Exploratory Estimate (Forecast)',
            line=dict(color='#F4C542', width=3, dash='dash'),
            marker=dict(size=9, symbol='star', color='#F4C542', line=dict(color='#214D32', width=1.5))
        ))
        fig_fc.add_trace(go.Scatter(
            x=list(future_df['Year']) + list(future_df['Year'])[::-1],
            y=list(future_df['Upper_CI_MT']) + list(future_df['Lower_CI_MT'])[::-1],
            fill='toself', fillcolor='rgba(244, 197, 66, 0.22)',
            line=dict(color='rgba(139, 94, 60, 0.25)', width=1, dash='dot'),
            hoverinfo="skip", showlegend=True, name='95% Confidence Interval Band'
        ))
        fig_fc.update_layout(
            **PLOT_THEME,
            title=f"<b>Actual vs. Model-Predicted Production & Future Exploratory Trajectory ({geo_label})</b>",
            xaxis_title="Calendar Year",
            yaxis_title="Volume of Production (Metric Tons)",
            hovermode="x unified",
            margin=dict(l=25, r=25, t=45, b=25),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_fc.update_yaxes(gridcolor='#EADBCA')
        fig_fc.update_xaxes(gridcolor='#EADBCA', dtick=1)
        st.plotly_chart(fig_fc, use_container_width=True)
        render_explanation(
            "Time-Series Forecasting Model",
            "This chart shows exploratory production projections calculated using Holt's Linear Double Exponential Smoothing, an established statistical method for trending data. "
            "The dark green line shows the historical data used to train the model, the lighter green line shows held-out test data used to verify accuracy, and the dashed yellow line shows exploratory future estimates. "
            "The shaded yellow band represents the 95% confidence interval, indicating the statistical range of likely future outcomes based on historical volatility."
        )

        st.markdown("<div class='section-title'>📋 Projected Future Estimates (Exploratory Scenario Table)</div>", unsafe_allow_html=True)
        st.dataframe(
            future_df[['Year', 'Projected_MT', 'Lower_CI_MT', 'Upper_CI_MT', 'Type']].style.format({
                'Projected_MT': '{:,.2f}',
                'Lower_CI_MT': '{:,.2f}',
                'Upper_CI_MT': '{:,.2f}'
            }),
            use_container_width=True,
            column_config={
                "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
                "Projected_MT": st.column_config.NumberColumn("Projected Estimate (Metric Tons)", format="%,.2f MT"),
                "Lower_CI_MT": st.column_config.NumberColumn("Lower 95% Confidence Bound (MT)", format="%,.2f MT"),
                "Upper_CI_MT": st.column_config.NumberColumn("Upper 95% Confidence Bound (MT)", format="%,.2f MT"),
                "Type": st.column_config.TextColumn("Projection Type")
            }
        )
        render_explanation(
            "Projected Scenario Table",
            "This table details the projected production estimates for future years along with their estimated lower and upper 95% confidence bounds. "
            "These numbers provide agricultural planners with an objective baseline for scenario planning and should be interpreted as statistical estimates rather than guaranteed future yields."
        )
    else:
        st.warning("Insufficient continuous historical observations to train the time-series model. Please expand your year selection.")

def show_mathematical_methodology():
    st.markdown("<div class='section-title'>📐 Mathematical Formulations & Statistical Methods</div>", unsafe_allow_html=True)
    st.markdown("""
    This section documents the formal mathematical and statistical formulas implemented in the **Banana Scope PH Advanced Analytics Engine**:

    ### 1. Year-over-Year (YoY) Growth Rate
    Measures the annual percentage rate of expansion or contraction between consecutive years:
    $$\\Delta V_t = V_t - V_{t-1}$$
    $$\\text{YoY Growth Rate } (\\%) = \\left( \\frac{V_t - V_{t-1}}{V_{t-1}} \\right) \\times 100$$
    *Where $V_t$ is the volume of production in year $t$, and $V_{t-1}$ is the volume in the preceding year.*

    ---

    ### 2. Compound Annual Growth Rate (CAGR)
    Provides a smoothed annualized rate of agricultural growth over an $n$-year horizon, removing intervening volatility:
    $$\\text{CAGR} = \\left( \\frac{V_{\\text{end}}}{V_{\\text{start}}} \\right)^{\\frac{1}{n}} - 1$$
    *Where $V_{\\text{start}}$ is the baseline volume, $V_{\\text{end}}$ is the ending volume, and $n$ is the number of elapsed years.*

    ---

    ### 3. Ordinary Least Squares (OLS) Linear Trend
    Determines the baseline linear slope of production trajectory:
    $$\\hat{y}_t = \\beta_0 + \\beta_1 t$$
    $$\\beta_1 = \\frac{\\sum_{i=1}^n (t_i - \\bar{t})(y_i - \\bar{y})}{\\sum_{i=1}^n (t_i - \\bar{t})^2}, \\quad \\beta_0 = \\bar{y} - \\beta_1 \\bar{t}$$
    The Goodness of Fit ($R^2$) reflects the proportion of volume variance explained by the chronological trend:
    $$R^2 = 1 - \\frac{\\sum (y_i - \\hat{y}_i)^2}{\\sum (y_i - \\bar{y})^2}$$

    ---

    ### 4. Statistical Anomaly & Outlier Detection (Z-Score)
    Standardizes historical production observations into standard deviation units to isolate shock years:
    $$Z_t = \\frac{V_t - \\mu}{\\sigma}$$
    *Where $\\mu$ is the historical sample mean and $\\sigma$ is the sample standard deviation.*
    * **High Anomaly Threshold:** $Z_t > +1.4$ (Identifies significant harvest booms).
    * **Low Shock Threshold:** $Z_t < -1.4$ (Identifies severe pest outbreaks, drought, or typhoon devastation).

    ---

    ### 5. Double Exponential Smoothing (Holt's Linear Trend Forecasting)
    Applies recursive smoothing to update both the series level $(\\ell_t)$ and growth trend $(b_t)$:
    $$\\text{Level Equation:} \\quad \\ell_t = \\alpha y_t + (1 - \\alpha)(\\ell_{t-1} + b_{t-1})$$
    $$\\text{Trend Equation:} \\quad b_t = \\beta (\\ell_t - \\ell_{t-1}) + (1 - \\beta) b_{t-1}$$
    $$\\text{Forecast Equation:} \\quad \\hat{y}_{t+h} = \\ell_t + h b_t$$
    *Parameters:* Smoothing weight $\\alpha = 0.6$, Trend weight $\\beta = 0.2$, Forecast lead time $h$.

    ---

    ### 6. Forecast Accuracy Evaluation Metrics
    * **Mean Absolute Error (MAE):** $\\text{MAE} = \\frac{1}{n} \\sum_{i=1}^n |y_i - \\hat{y}_i|$
    * **Root Mean Squared Error (RMSE):** $\\text{RMSE} = \\sqrt{ \\frac{1}{n} \\sum_{i=1}^n (y_i - \\hat{y}_i)^2 }$
    * **Mean Absolute Percentage Error (MAPE):** $\\text{MAPE} = \\frac{100\\%}{n} \\sum_{i=1}^n \\left| \\frac{y_i - \\hat{y}_i}{y_i} \\right|$
    """)


