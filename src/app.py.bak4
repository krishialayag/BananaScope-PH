            hovermode="x unified",
            margin=dict(l=60, r=40, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,248,0.85)")
        )
        fig_cult_growth.update_traces(marker=dict(size=7, line=dict(color='#FFFDF8', width=1.5)))
        fig_cult_growth.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=12)
        fig_cult_growth.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_cult_growth, use_container_width=True)
        render_explanation(
            "Variety Trajectory Comparison",
            "This line chart tracks and compares the historical production volumes of individual banana varieties over time. "
            "It reveals how commercial export Cavendish experienced sharp declines after 2018 due to disease outbreaks, "
            "while domestic staple varieties like Saba exhibited greater resilience and stability across the same period."
        )
    else:
        st.warning("No multi-variety records available for current selection.")
    render_bottom_back_button()

def render_anomalies_scatter_view():
    render_back_button()
    st.markdown("<div class='section-title'>🔍 Statistical Detection of Extreme Harvests & Production Shocks (Z-Scores)</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 4:
        anom_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        anom_df = detect_statistical_anomalies(anom_base, z_thresh=1.4)

        # Non-overlapping text: only show text on flagged anomaly points!
        anomaly_text = [str(y) if flag != 'Normal Production' else '' for y, flag in zip(anom_df['Year'], anom_df['Anomaly_Flag'])]

        fig_anom = px.scatter(
            anom_df, x='Year', y='Volume_MT', color='Anomaly_Flag',
            size=np.abs(anom_df['Z_Score']) + 3.0,
            color_discrete_map={
                'Normal Production': '#387A45',
                'Unusually High Output': '#F4C542',
                'Unusually Low Shock': '#8B5E3C',
                'Unrecorded': '#9ca3af'
            },
            labels={'Volume_MT': 'Harvest Volume (Metric Tons)', 'Year': 'Calendar Year'},
            text=anomaly_text
        )
        fig_anom.update_traces(
            textposition='top center',
            textfont=dict(size=12, family="'Plus Jakarta Sans', sans-serif", color='#214D32'),
            marker=dict(line=dict(color='#214D32', width=1.5))
        )
        
        v_mean = anom_base['Volume_MT'].mean()
        v_std = anom_base['Volume_MT'].std()
        fig_anom.add_hline(y=v_mean, line_color="#214D32", line_width=2, annotation_text=f"Historical Mean: {v_mean/1e3:.1f}K MT", annotation_position="top left")
        fig_anom.add_hline(y=v_mean + 1.4 * v_std, line_dash="dot", line_color="#F4C542", line_width=2, annotation_text="+1.4σ Upper Bound (Boom)", annotation_position="top left")
        fig_anom.add_hline(y=max(0, v_mean - 1.4 * v_std), line_dash="dot", line_color="#8B5E3C", line_width=2, annotation_text="-1.4σ Lower Bound (Shock)", annotation_position="bottom left")

        fig_anom.update_layout(
            **PLOT_THEME,
            height=500,
            margin=dict(l=60, r=40, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
        )
        fig_anom.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=12)
        fig_anom.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_anom, use_container_width=True)
        render_explanation(
            "Statistical Anomaly & Shock Detection",
            "This scatter plot uses standardized statistical scores (Z-scores) to objectively identify unusual harvest years that deviated significantly from normal historical levels. "
            "Data points falling below the lower dotted line represent severe agricultural shock years—such as major typhoon damage or severe droughts—while points above the upper dotted line indicate exceptional harvest booms. "
            "In Oriental Mindoro, for instance, this chart clearly flags the severe harvest drops following Typhoon Nona (2016) and Typhoons Tisoy and Ursula (2020)."
        )
    else:
        st.info("At least 4 observation years are required to compute statistical Z-score bounds.")
    render_bottom_back_button()

def render_anomalies_table_view():
    render_back_button()
    st.markdown("<div class='section-title'>⚠️ Summary Table of Flagged Statistical Anomaly Years</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 4:
        anom_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        anom_df = detect_statistical_anomalies(anom_base, z_thresh=1.4)
        flagged_rows = anom_df[anom_df['Anomaly_Flag'] != 'Normal Production']
        if not flagged_rows.empty:
            display_flags = flagged_rows[['Year', 'Volume_MT', 'Z_Score', 'Anomaly_Flag']].copy()
            st.dataframe(
                display_flags.style.format({'Volume_MT': '{:,.2f}', 'Z_Score': '{:+.2f}'}),
                use_container_width=True,
                column_config={
                    "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
                    "Volume_MT": st.column_config.NumberColumn("Harvest Volume (Metric Tons)", format="%,.2f MT"),
                    "Z_Score": st.column_config.NumberColumn("Standardized Z-Score", format="%+.2f"),
                    "Anomaly_Flag": st.column_config.TextColumn("Statistical Classification")
                }
            )
            render_explanation(
                "Anomaly Summary Table",
                "This table lists the specific calendar years that were classified as statistically unusual within your current filter scope. "
                "For each flagged observation, it provides the recorded harvest volume, the calculated Z-score, and whether it was an unusually high harvest or an unusually severe production shock."
            )
        else:
            st.success("All observed production years in this selection remain within standard statistical variance bounds (between -1.4σ and +1.4σ).")
    else:
        st.info("At least 4 observation years are required to compute statistical Z-score bounds.")
    render_bottom_back_button()

def render_forecasting_chart_view():
    render_back_button()
    st.markdown("<div class='section-title'>🔮 Exploratory Time-Series Production Forecast (Holt's Linear Smoothing)</div>", unsafe_allow_html=True)
    st.markdown("""
    <div class="warning-banner">
        ⚠️ <b>Academic Disclaimer & Methodological Note:</b><br>
        The projections generated below are <b>exploratory statistical estimates</b> calculated using 
        Double Exponential Smoothing (Holt's Linear Trend Model). They are designed for scenario planning and research exercises, 
        and should <b>not be treated as certified actual production figures</b>.
    </div>
    """, unsafe_allow_html=True)

    fc_horizon = st.slider("Select Forecast Horizon (Years into the future):", min_value=2, max_value=5, value=4)
    fc_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
    
    forecast_results = run_time_series_forecast(fc_base, train_ratio=0.8, forecast_horizon=fc_horizon)

    if forecast_results is not None:
        metrics = forecast_results['eval_metrics']
        train_df = forecast_results['train_df']
        test_df = forecast_results['test_df']
        future_df = forecast_results['forecast_df']

        f1, f2, f3 = st.columns(3)
        with f1:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Mean Absolute Error (MAE)</div>
                <div class="trend-metric-val">{metrics['MAE_MT']/1e3:,.1f}K <span style="font-size:0.95rem;font-weight:600;">MT</span></div>
                <div class="trend-metric-sub">Average Magnitude of Forecast Error</div>
            </div>
            """, unsafe_allow_html=True)
        with f2:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Root Mean Squared Error (RMSE)</div>
                <div class="trend-metric-val">{metrics['RMSE_MT']/1e3:,.1f}K <span style="font-size:0.95rem;font-weight:600;">MT</span></div>
                <div class="trend-metric-sub">Standard Deviation of Residuals</div>
            </div>
            """, unsafe_allow_html=True)
        with f3:
            st.markdown(f"""
            <div class="trend-metric-card">
                <div class="trend-metric-label">Mean Absolute % Error (MAPE)</div>
                <div class="trend-metric-val">{metrics['MAPE_Pct']:.2f}%</div>
                <div class="trend-metric-sub">Test Accuracy (< 10% is Highly Accurate)</div>
            </div>
            """, unsafe_allow_html=True)

        st.caption(f"🧪 **Validation Setup:** Trained on {metrics['Train_Years']} • Evaluated on held-out test data from {metrics['Test_Years']}.")

        fig_fc = go.Figure()
        fig_fc.add_trace(go.Scatter(
            x=train_df['Year'], y=train_df['Volume_MT'],
            mode='lines+markers', name='Historical Training Data',
            line=dict(color='#214D32', width=2.8), marker=dict(size=7, color='#214D32')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Volume_MT'],
            mode='lines+markers', name='Actual Test Data (Holdout)',
            line=dict(color='#387A45', width=2.8), marker=dict(size=8, symbol='diamond', color='#387A45')
        ))
        fig_fc.add_trace(go.Scatter(
            x=test_df['Year'], y=test_df['Predicted_MT'],
            mode='lines+markers', name='Model Test Predictions',
            line=dict(color='#8B5E3C', width=2, dash='dot'), marker=dict(size=7, symbol='cross', color='#8B5E3C')
        ))
        fig_fc.add_trace(go.Scatter(
            x=future_df['Year'], y=future_df['Projected_MT'],
            mode='lines+markers', name='Exploratory Estimate (Forecast)',
            line=dict(color='#F4C542', width=3, dash='dash'),
            marker=dict(size=9, symbol='star', color='#F4C542', line=dict(color='#214D32', width=1.5))
        ))
        fig_fc.add_trace(go.Scatter(
            x=list(future_df['Year']) + list(future_df['Year'])[::-1],
            y=list(future_df['Upper_CI_MT']) + list(future_df['Lower_CI_MT'])[::-1],
            fill='toself', fillcolor='rgba(244, 197, 66, 0.22)',
            line=dict(color='rgba(139, 94, 60, 0.25)', width=1, dash='dot'),
            hoverinfo="skip", showlegend=True, name='95% Confidence Interval Band'
        ))
        fig_fc.update_layout(
            **PLOT_THEME,
            height=520,
            title=f"<b>Actual vs. Model-Predicted Production & Future Exploratory Trajectory ({geo_label})</b>",
            xaxis_title="Calendar Year",
            yaxis_title="Volume of Production (Metric Tons)",
            hovermode="x unified",
            margin=dict(l=60, r=40, t=60, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,248,0.85)")
        )
        fig_fc.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=12)
        fig_fc.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_fc, use_container_width=True)
        render_explanation(
            "Time-Series Forecasting Model",
            "This chart shows exploratory production projections calculated using Holt's Linear Double Exponential Smoothing, an established statistical method for trending data. "
            "The dark green line shows the historical data used to train the model, the lighter green line shows held-out test data used to verify accuracy, and the dashed yellow line shows exploratory future estimates. "
            "The shaded yellow band represents the 95% confidence interval, indicating the statistical range of likely future outcomes based on historical volatility."
        )
    else:
        st.warning("Insufficient continuous historical observations to train the time-series model. Please expand your year selection.")
    render_bottom_back_button()

