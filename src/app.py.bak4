# -----------------------------------------------------------------------------
# 2. DATA INGESTION & CACHING (PRESERVED 100%)
# -----------------------------------------------------------------------------
@st.cache_data
def load_dataset():
    """Loads and standardizes the cleaned dataset."""
    possible_paths = [
        "outputs/cleaned_banana_data.csv",
        "cleaned_banana_data.csv",
        "data/cleaned_banana_data.csv"
    ]
    for path in possible_paths:
        if os.path.exists(path):
            df = pd.read_csv(path)
            df['Year'] = df['Year'].astype(int)
            df['Volume_MT'] = pd.to_numeric(df['Volume_MT'], errors='coerce')
            return df
            
    st.error("Cleaned dataset not found! Please run `src/data_cleaning.py` first.")
    st.stop()

df = load_dataset()


# -----------------------------------------------------------------------------
# 3. SIDEBAR CONTROLS & INTERACTIVE FILTERS (PRESERVED 100% FUNCTIONALITY)
# -----------------------------------------------------------------------------
with st.sidebar:
    st.markdown("""
    <div class="sidebar-brand-box">
        <div class="sidebar-brand-title">
            <span>🍌</span> Banana Scope PH
        </div>
        <div class="sidebar-brand-subtitle">
            Philippine Banana Production Analytics Platform (2010–2026)
        </div>
        <span class="sidebar-tag">🇵🇭 DepEd MIMAROPA • Grade 12</span>
    </div>
    """, unsafe_allow_html=True)

    st.markdown("### 🎛️ **Surveillance Filters**")
    st.caption("Interactive multi-attribute agricultural surveillance filters.")

    # 1. Year Range Filter (PRESERVED)
    min_year = int(df['Year'].min())
    max_year = int(df['Year'].max())
    selected_years = st.slider(
        "📅 **Select Year Horizon:**",
        min_value=min_year,
        max_value=max_year,
        value=(2010, min(2024, max_year)),
        step=1
    )

    # 2. Measurement Frequency (PRESERVED)
    period_options = ["Annual (Recommended)", "Quarterly (Q1–Q4)", "Semester (S1–S2)"]
    selected_period_type = st.radio(
        "⏱️ **Reporting Frequency:**",
        options=period_options,
        index=0,
        help="Annual totals prevent double-counting. Choose Quarterly to inspect intra-annual cycles."
    )

    quarter_filter = "All"
    if selected_period_type == "Quarterly (Q1–Q4)":
        quarter_filter = st.selectbox("Select Specific Quarter:", ["All", "Q1", "Q2", "Q3", "Q4"])

    st.markdown("---")

    # 3. Banana Variety Scope (PRESERVED)
    all_varieties = sorted(df['Crop'].unique().tolist())
    variety_mode = st.radio(
        "🍌 **Cultivar Scope:**",
        ["Total Banana (Aggregated)", "Specific Cultivars Breakdown", "Custom Selection"],
        index=0
    )

    if variety_mode == "Total Banana (Aggregated)":
        selected_varieties = ["Banana (Total)"]
    elif variety_mode == "Specific Cultivars Breakdown":
        selected_varieties = [v for v in all_varieties if v != "Banana (Total)"]
    else:
        selected_varieties = st.multiselect(
            "Select Banana Varieties:",
            options=all_varieties,
            default=["Banana (Total)"]
        )
        if not selected_varieties:
            selected_varieties = ["Banana (Total)"]

    st.markdown("---")

    # 4. Regional Filter (PRESERVED)
    available_regions = sorted(df[df['Hierarchy_Level'] == 'Regional']['Region'].unique().tolist())
    all_regions_opt = "All Administrative Regions (National Scope)"
    region_options = [all_regions_opt] + available_regions

    selected_region = st.selectbox(
        "🗺️ **Select Region:**",
        options=region_options,
        index=0
    )

    # 5. Cascading Provincial Filter (PRESERVED)
    if selected_region == all_regions_opt:
        available_provinces = sorted(df[df['Hierarchy_Level'].isin(['Provincial', 'City'])]['Province_City'].unique().tolist())
    else:
        available_provinces = sorted(df[(df['Region'] == selected_region) & 
                                        (df['Hierarchy_Level'].isin(['Provincial', 'City']))]['Province_City'].unique().tolist())

    all_prov_opt = "All Provinces / Cities"
    province_options = [all_prov_opt] + available_provinces

    selected_province = st.selectbox(
        "📍 **Select Province / City:**",
        options=province_options,
        index=0
    )

    st.markdown("---")
    st.markdown("""
    <div class="sidebar-footer-card">
        <strong>🏫 Leuteboro National High School</strong><br>
        Fundamentals of Data Analytics (2026–2027)<br>
        Supervised by <strong>Sir Aldrin D. Magtibay</strong><br>
        <em>Department of Education — Division of Oriental Mindoro</em>
    </div>
    """, unsafe_allow_html=True)


# -----------------------------------------------------------------------------
# 4. FILTERING LOGIC (PRESERVED 100%)
# -----------------------------------------------------------------------------
filtered_df = df[(df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1])].copy()

# Period Type Filter
if selected_period_type == "Annual (Recommended)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Annual'].copy()
elif selected_period_type == "Quarterly (Q1–Q4)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Quarterly'].copy()
    if quarter_filter != "All":
        filtered_df = filtered_df[filtered_df['Period'] == quarter_filter].copy()
elif selected_period_type == "Semester (S1–S2)":
    filtered_df = filtered_df[filtered_df['Period_Type'] == 'Semester'].copy()

# Cultivar Filter
filtered_df = filtered_df[filtered_df['Crop'].isin(selected_varieties)].copy()

# Geographic Hierarchy Routing
if selected_province != all_prov_opt:
    active_df = filtered_df[filtered_df['Province_City'] == selected_province].copy()
    geo_label = selected_province
    geo_level = "Provincial"
elif selected_region != all_regions_opt:
    active_df = filtered_df[(filtered_df['Region'] == selected_region) & 
                            (filtered_df['Hierarchy_Level'] == 'Regional')].copy()
    geo_label = selected_region
    geo_level = "Regional"
else:
    active_df = filtered_df[filtered_df['Hierarchy_Level'] == 'National'].copy()
    geo_label = "Philippines (National Aggregate)"
    geo_level = "National"


# -----------------------------------------------------------------------------
# 5. DASHBOARD HERO HEADER (REDESIGNED TROPICAL AGRI-THEME)
# -----------------------------------------------------------------------------
st.markdown("""
<div class="hero-banner">
    <div class="hero-header-row">
        <div>
            <h1 class="hero-title">
                <span>🍌</span> Banana Scope PH
            </h1>
            <p class="hero-subtitle">
                Philippine Banana Production Analytics & Surveillance Platform (2010–2026)
            </p>
            <div class="hero-badges-container">
                <span class="hero-pill-badge">🌾 Official PSA OpenStat Provenance</span>
                <span class="hero-pill-badge green-pill">🌿 15-Year Longitudinal Scope</span>
                <span class="hero-pill-badge brown-pill">🏛️ DepEd Oriental Mindoro Capstone</span>
            </div>
        </div>
    </div>
</div>
""", unsafe_allow_html=True)


# -----------------------------------------------------------------------------
# 6. ENLARGED 2 × 2 KPI SUMMARY CARDS (PRESERVED CALCULATIONS)
# -----------------------------------------------------------------------------
valid_vols = active_df['Volume_MT'].dropna()
total_production_mt = valid_vols.sum()

if not active_df.empty and active_df['Year'].nunique() > 0:
    yearly_totals = active_df.groupby('Year')['Volume_MT'].sum()
    avg_annual_mt = yearly_totals.mean()
    if not yearly_totals.empty:
        peak_year = int(yearly_totals.idxmax())
        peak_vol_mt = yearly_totals.max()
        lowest_year = int(yearly_totals.idxmin())
        lowest_vol_mt = yearly_totals.min()
    else:
        peak_year, peak_vol_mt, lowest_year, lowest_vol_mt = "N/A", 0, "N/A", 0
else:
    avg_annual_mt = 0
    peak_year, peak_vol_mt, lowest_year, lowest_vol_mt = "N/A", 0, "N/A", 0

# Benchmark Top Producing Region across selected period (PRESERVED)
reg_benchmark = df[
    (df['Year'] >= selected_years[0]) & 
    (df['Year'] <= selected_years[1]) & 
    (df['Hierarchy_Level'] == 'Regional') &
    (df['Crop'].isin(selected_varieties)) &
    (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly'))
]
if not reg_benchmark.empty:
    top_reg_series = reg_benchmark.groupby('Region')['Volume_MT'].sum()
    top_region_name = top_reg_series.idxmax().replace("REGION ", "Reg ").replace("ADMINISTRATIVE REGION", "CAR")
    top_region_vol = top_reg_series.max()
else:
    top_region_name, top_region_vol = "N/A", 0


# -----------------------------------------------------------------------------
# 7. CHART & TABLE HELPERS (NON-OVERLAPPING STYLES & EXPLANATIONS)
# -----------------------------------------------------------------------------
PLOT_THEME = dict(
    plot_bgcolor="#FFFDF8",
    paper_bgcolor="#FFFDF8",
    font=dict(family="'Plus Jakarta Sans', sans-serif", color="#214D32"),
    hoverlabel=dict(bgcolor="#214D32", font_color="#FFFDF8", font_family="'Plus Jakarta Sans', sans-serif")
)

def render_explanation(chart_title, explanation_text):
    st.markdown(f"""
    <div class="chart-explanation">
        <div class="chart-explanation-title">📖 Understanding This Chart: {chart_title}</div>
        <div class="chart-explanation-body">{explanation_text}</div>
    </div>
    """, unsafe_allow_html=True)

def render_back_button():
    c_btn, c_space = st.columns([1.5, 4])
    with c_btn:
        if st.button("⬅️ Back to Dashboard Home", key="btn_back_top", type="primary", use_container_width=True):
            st.session_state.active_view = "HOME"
            st.rerun()

def render_bottom_back_button():
    c_space, c_btn = st.columns([4, 1.5])
    with c_btn:
        if st.button("⬅️ Back to Dashboard Home", key="btn_back_bottom", type="secondary", use_container_width=True):
            st.session_state.active_view = "HOME"
            st.rerun()


# =============================================================================
# REUSABLE CHART & TABLE VIEW FUNCTIONS (CLEAN, NON-OVERLAPPING)
# =============================================================================

def render_annual_trajectory_view():
    render_back_button()
    st.markdown("<div class='section-title'>📈 Annual Banana Production Trajectory (Metric Tons)</div>", unsafe_allow_html=True)
    if not active_df.empty:
        annual_plot_data = active_df.groupby(['Year', 'Crop'])['Volume_MT'].sum().reset_index()
        fig_traj = px.line(
            annual_plot_data, x='Year', y='Volume_MT', color='Crop',
            markers=True, line_shape='spline',
            color_discrete_sequence=['#214D32', '#387A45', '#F4C542', '#8B5E3C', '#D4A017', '#5C8247'],
            labels={'Volume_MT': 'Volume (Metric Tons)', 'Year': 'Calendar Year'}
        )
        fig_traj.update_layout(
            **PLOT_THEME,
            height=500,
            hovermode="x unified",
            margin=dict(l=60, r=40, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,248,0.85)")
        )
        fig_traj.update_traces(marker=dict(size=8, line=dict(color='#FFFDF8', width=1.5)))
        fig_traj.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=12)
        fig_traj.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_traj, use_container_width=True)
        render_explanation(
            "Annual Production Trajectory",
            "This line chart tracks the total volume of bananas harvested each year within your selected geographic area and banana varieties. "
            "It allows viewers to easily see whether production has been rising, falling, or remaining stable over the 15-year historical timeline. "
            "For national figures, notice the expansion up to the 2018 historical peak followed by a continuous contraction in recent years."
        )
    else:
        st.warning("No data available for the current filter selection.")
    render_bottom_back_button()

def render_quarterly_seasonality_view():
    render_back_button()
    st.markdown("<div class='section-title'>⏱️ Seasonal Quarterly Harvest Patterns (Q1–Q4 Comparison)</div>", unsafe_allow_html=True)
    q_subset = df[(df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & (df['Period_Type'] == 'Quarterly') & (df['Crop'].isin(selected_varieties))]
    if selected_province != all_prov_opt:
        q_subset = q_subset[q_subset['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        q_subset = q_subset[(q_subset['Region'] == selected_region) & (q_subset['Hierarchy_Level'] == 'Regional')]
    else:
        q_subset = q_subset[q_subset['Hierarchy_Level'] == 'National']

    if not q_subset.empty:
        q_agg = q_subset.groupby('Period')['Volume_MT'].mean().reindex(['Q1', 'Q2', 'Q3', 'Q4']).reset_index()
        # Formatted labels avoiding decimal clutter and collisions
        labels_txt = [f"{v/1e6:.2f}M MT" if v >= 1e6 else f"{v/1e3:,.0f}K MT" for v in q_agg['Volume_MT']]
        fig_q = px.bar(
            q_agg, x='Period', y='Volume_MT', color='Period',
            color_discrete_sequence=['#8B5E3C', '#387A45', '#F4C542', '#214D32'],
            labels={'Volume_MT': 'Average Volume (Metric Tons)', 'Period': 'Quarter'},
            text=labels_txt
        )
        max_val = q_agg['Volume_MT'].max()
        fig_q.update_traces(
            marker_line_color='#214D32', marker_line_width=1,
            textposition='outside', cliponaxis=False,
            textfont=dict(size=12, family="'Plus Jakarta Sans', sans-serif", color='#214D32')
        )
        fig_q.update_layout(
            **PLOT_THEME,
            height=480,
            showlegend=False,
            margin=dict(l=60, r=40, t=50, b=50)
        )
        fig_q.update_yaxes(gridcolor='#EADBCA', range=[0, max_val * 1.18], tickformat=",.0f")
        fig_q.update_xaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_q, use_container_width=True)
        render_explanation(
            "Quarterly Harvest Seasonality",
            "This bar chart compares average banana production across the four calendar quarters to highlight seasonal harvesting rhythms. "
            "The data clearly demonstrates that Quarter 1 (January to March) consistently experiences the lowest harvest volume of the year, "
            "while Quarters 2, 3, and 4 maintain a stable, high-volume production plateau. "
            "Farmers, cooperatives, and buyers can use this seasonal pattern to prepare for annual supply swings and market price adjustments."
        )
    else:
        st.warning("No quarterly records found for the current selection.")
    render_bottom_back_button()

def render_regional_rankings_view():
    render_back_button()
    st.markdown("<div class='section-title'>🗺️ Regional Banana Production Comparison Across the Philippines</div>", unsafe_allow_html=True)
    reg_data = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Hierarchy_Level'] == 'Regional') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly')) &
        (df['Crop'].isin(selected_varieties))
    ].groupby('Region')['Volume_MT'].sum().reset_index().sort_values('Volume_MT', ascending=True)

    if not reg_data.empty:
        reg_data['Clean_Region'] = reg_data['Region'].str.replace(r'REGION [IVX]+ \((.*?)\)', r'\1', regex=True)
        # Formatted labels avoiding overlapping numbers
        bar_labels = [f"{v/1e6:.2f}M MT" if v >= 1e6 else f"{v/1e3:,.0f}K MT" for v in reg_data['Volume_MT']]
        fig_reg = px.bar(
            reg_data, x='Volume_MT', y='Clean_Region', orientation='h',
            color='Volume_MT', color_continuous_scale=['#FFF8E7', '#F4C542', '#387A45', '#214D32'],
            labels={'Volume_MT': 'Total Production (Metric Tons)', 'Clean_Region': 'Administrative Region'},
            text=bar_labels
        )
        max_reg = reg_data['Volume_MT'].max()
        fig_reg.update_traces(
            marker_line_color='#214D32', marker_line_width=0.8,
            textposition='outside', cliponaxis=False,
            textfont=dict(size=10.5, family="'Plus Jakarta Sans', sans-serif")
        )
        fig_reg.update_layout(
            **PLOT_THEME,
            height=max(540, len(reg_data) * 32),
            coloraxis_showscale=False,
            margin=dict(l=150, r=70, t=40, b=40)
        )
        fig_reg.update_xaxes(gridcolor='#EADBCA', range=[0, max_reg * 1.2], tickformat=",.0f")
        fig_reg.update_yaxes(gridcolor='#EADBCA')
        st.plotly_chart(fig_reg, use_container_width=True)
        render_explanation(
            "Regional Production Comparison",
            "This horizontal bar chart ranks Philippine administrative regions from highest to lowest based on total banana output. "
            "It highlights the significant concentration of production in Mindanao, where Davao Region, Northern Mindanao, and SOCCSKSARGEN "
            "account for over 76% of all Philippine bananas. "
            "Island regions like MIMAROPA produce smaller national shares that remain vital for provincial food security."
        )
    else:
        st.warning("No regional records found for current filters.")
    render_bottom_back_button()

def render_cultivar_donut_view():
    render_back_button()
    st.markdown("<div class='section-title'>🍌 Market Share Breakdown by Banana Variety</div>", unsafe_allow_html=True)
    cult_df = df[
        (df['Year'] >= selected_years[0]) & (df['Year'] <= selected_years[1]) & 
        (df['Crop'] != 'Banana (Total)') & 
        (df['Period_Type'] == ('Annual' if selected_period_type == "Annual (Recommended)" else 'Quarterly'))
    ]
    if selected_province != all_prov_opt:
        cult_df = cult_df[cult_df['Province_City'] == selected_province]
    elif selected_region != all_regions_opt:
        cult_df = cult_df[(cult_df['Region'] == selected_region) & (cult_df['Hierarchy_Level'] == 'Regional')]
    else:
        cult_df = cult_df[cult_df['Hierarchy_Level'] == 'National']

    if not cult_df.empty:
        cult_agg = cult_df.groupby('Crop')['Volume_MT'].sum().reset_index()
        cult_agg['Crop_Name'] = cult_agg['Crop'].str.replace('Banana ', '')
        fig_donut = px.pie(
            cult_agg, names='Crop_Name', values='Volume_MT', hole=0.48,
            color_discrete_sequence=['#F4C542', '#387A45', '#214D32', '#8B5E3C', '#D4A017', '#5C8247']
        )
        fig_donut.update_traces(
            marker=dict(line=dict(color='#FFFDF8', width=2)),
            textposition='inside', textinfo='percent+label',
            textfont=dict(size=12, color='#FFFFFF')
        )
        fig_donut.update_layout(
            **PLOT_THEME,
            height=480,
            margin=dict(l=30, r=30, t=40, b=40),
            legend=dict(orientation="h", yanchor="bottom", y=-0.18, xanchor="center", x=0.5)
        )
        st.plotly_chart(fig_donut, use_container_width=True)
        render_explanation(
            "Cultivar Market Composition",
            "This donut chart displays the percentage share of each major banana variety in total recorded production. "
            "Cavendish (grown primarily for international export) and Saba (used widely for local cooking and banana chips) "
            "together make up roughly 80% of all bananas grown in the country. "
            "Popular table dessert varieties like Lakatan and Latundan account for most of the remaining domestic harvest."
        )
    else:
        st.warning("No cultivar records found for current selection.")
    render_bottom_back_button()

def render_records_table_view():
    render_back_button()
    st.markdown("<div class='section-title'>📋 Official Banana Production Records Explorer</div>", unsafe_allow_html=True)
    table_display = active_df[['Year', 'Period', 'Crop', 'Region', 'Province_City', 'Volume_MT', 'Data_Status']].sort_values(by=['Year', 'Crop'], ascending=[False, True])
    st.dataframe(
        table_display.style.format({'Volume_MT': '{:,.2f}'}),
        use_container_width=True,
        height=380,
        column_config={
            "Year": st.column_config.NumberColumn("Calendar Year", format="%d"),
            "Period": st.column_config.TextColumn("Reporting Period"),
            "Crop": st.column_config.TextColumn("Banana Variety"),
            "Region": st.column_config.TextColumn("Administrative Region"),
            "Province_City": st.column_config.TextColumn("Province / City"),
            "Volume_MT": st.column_config.NumberColumn("Volume (Metric Tons)", format="%,.2f MT"),
            "Data_Status": st.column_config.TextColumn("Data Audit Status")
        }
    )
    render_explanation(
        "Production Records Table",
        "This interactive table presents the verified statistical production records matching your active filter selections. "
        "You can sort any column by clicking its header, search for specific terms, or download the filtered dataset as a spreadsheet using the button below. "
        "This feature is especially useful for municipal planners and researchers who require exact numbers for agricultural reporting."
    )
    csv_bytes = table_display.to_csv(index=False).encode('utf-8')
    st.download_button(
        "📥 Download Filtered Records as CSV",
        data=csv_bytes,
        file_name=f"bananascope_filtered_{selected_years[0]}_{selected_years[1]}.csv",
        mime="text/csv"
    )
    render_bottom_back_button()

def render_yoy_growth_view():
    render_back_button()
    st.markdown("<div class='section-title'>📊 Annual Year-over-Year Percentage Growth (% Change)</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 2:
        yoy_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        yoy_df = compute_yoy_growth(yoy_base)
        yoy_clean = yoy_df.dropna(subset=['YoY_Growth_Pct']).copy()
        yoy_clean['Growth_Color'] = np.where(yoy_clean['YoY_Growth_Pct'] >= 0, 'Expansion (+)', 'Contraction (-)')
        yoy_clean['Display_Text'] = yoy_clean['YoY_Growth_Pct'].apply(lambda x: f"{x:+.1f}%")

        min_pct = yoy_clean['YoY_Growth_Pct'].min()
        max_pct = yoy_clean['YoY_Growth_Pct'].max()
        y_lower = min(0, min_pct) * 1.3 if min_pct < 0 else -2
        y_upper = max(0, max_pct) * 1.3 if max_pct > 0 else 5

        fig_yoy = px.bar(
            yoy_clean, x='Year', y='YoY_Growth_Pct', color='Growth_Color',
            color_discrete_map={'Expansion (+)': '#387A45', 'Contraction (-)': '#8B5E3C'},
            labels={'YoY_Growth_Pct': 'Growth Rate (%)', 'Year': 'Calendar Year'},
            text='Display_Text'
        )
        fig_yoy.add_hline(y=0, line_dash="solid", line_color="#8B5E3C", line_width=1.5)
        fig_yoy.update_traces(
            textposition='outside', cliponaxis=False,
            textfont=dict(size=11, family="'Plus Jakarta Sans', sans-serif", color='#214D32'),
            marker_line_color='#214D32', marker_line_width=1
        )
        fig_yoy.update_layout(
            **PLOT_THEME,
            height=480,
            margin=dict(l=60, r=40, t=50, b=50),
            legend_title=""
        )
        fig_yoy.update_yaxes(gridcolor='#EADBCA', ticksuffix='%', range=[y_lower, y_upper], title_standoff=12)
        fig_yoy.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_yoy, use_container_width=True)
        render_explanation(
            "Year-over-Year Percentage Growth",
            "This bar chart illustrates the annual percentage increase or decrease in banana production compared to the previous year. "
            "Upward green bars show years when production expanded, while downward brown bars indicate years when harvests contracted. "
            "This visualization enables users to immediately identify periods of rapid growth or sharp harvest drops without having to calculate percentages manually."
        )
    else:
        st.warning("Insufficient data points to compute Year-over-Year growth rates. Expand the year horizon slider.")
    render_bottom_back_button()

def render_moving_average_view():
    render_back_button()
    st.markdown("<div class='section-title'>🌾 Production Volume with 3-Year Rolling Average & Long-Term Trendline</div>", unsafe_allow_html=True)
    if len(yearly_totals) >= 2:
        yoy_base = pd.DataFrame({'Year': yearly_totals.index, 'Volume_MT': yearly_totals.values})
        trend_df, t_stats = compute_trend_models(yoy_base)

        fig_smooth = go.Figure()
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Volume_MT'], mode='lines+markers',
            name='Actual Annual Output', line=dict(color='#214D32', width=3),
            marker=dict(size=8, color='#214D32', line=dict(color='#FFFDF8', width=1.5))
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['SMA_3'], mode='lines',
            name='3-Year Moving Average (SMA-3)', line=dict(color='#387A45', width=2.5, dash='dot')
        ))
        fig_smooth.add_trace(go.Scatter(
            x=trend_df['Year'], y=trend_df['Linear_Trend'], mode='lines',
            name=f"OLS Linear Trend (R² = {t_stats['r_squared']:.2f})", line=dict(color='#F4C542', width=2.5, dash='dash')
        ))
        fig_smooth.update_layout(
            **PLOT_THEME,
            height=500,
            hovermode="x unified",
            margin=dict(l=60, r=40, t=50, b=50),
            legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1, bgcolor="rgba(255,253,248,0.85)")
        )
        fig_smooth.update_yaxes(gridcolor='#EADBCA', tickformat=",.0f", title_standoff=12)
        fig_smooth.update_xaxes(gridcolor='#EADBCA', dtick=1, title_standoff=12)
        st.plotly_chart(fig_smooth, use_container_width=True)
        render_explanation(
            "3-Year Moving Average & Trendline",
            "This chart combines actual annual production totals with a 3-year smoothed moving average and a straight linear trendline. "
            "The 3-year moving average smooths out temporary annual spikes or dips to highlight the true multi-year direction of production, "
            "while the straight dashed line illustrates the average historical rate of change in metric tons per year."
        )
    else:
        st.warning("Insufficient data points to compute rolling moving averages.")
    render_bottom_back_button()

